import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";

export struct ListItem {
    id: int,
    label: string,
    count: int,
    artwork: image,
    has-artwork: bool,
    favorite: bool,
}

// Données partagées par les menus contextuels (morceaux, artistes, albums).
export global TrackMenu {
    // Playlists de la bibliothèque, pour « Ajouter à la playlist ».
    in property <[ListItem]> playlists;
    // Vue d'une playlist : « Retirer de la playlist » est proposé.
    in property <bool> in-playlist;
    // Vue « Most Played » : « Reset Play Count » est proposé.
    in property <bool> most-played;
}

// Entrée de menu ; `action` est transmise à Rust (« add-to-playlist:<id> » vise une playlist).
export struct MenuEntry {
    action: string,
    label: string,
    enabled: bool,
    danger: bool,
    // Filet au-dessus de l'entrée.
    separated: bool,
    // Entrée absente du menu (selon la vue) : les tableaux Slint ne se filtrent pas.
    hidden: bool,
    // Ouvre le sous-menu des playlists.
    submenu: bool,
}

// Menu contextuel au style de l'app (comme les menus « + »), à la place du menu natif
// du système qui ignore le thème. Le sous-menu liste les playlists de la bibliothèque.
export component ThemedMenu inherits PopupWindow {
    in property <[MenuEntry]> entries;
    callback selected(string);
    property <length> submenu-y;
    width: 220px;
    // Ouvrir le sous-menu ne doit pas refermer le menu : seuls un choix ou un clic dehors le ferment.
    close-policy: close-on-click-outside;

    Rectangle {
        background: Theme.footer-bg;
        border-radius: 4px;
        border-width: Theme.hairline;
        border-color: Theme.border-base;
        drop-shadow-blur: 10px;
        drop-shadow-color: #00000066;

        VerticalLayout {
            padding-top: 5px;
            padding-bottom: 5px;
            for entry in root.entries: VerticalLayout {
                if !entry.hidden && entry.separated: Rectangle {
                    height: 9px;
                    Rectangle {
                        height: Theme.hairline;
                        background: Theme.border;
                    }
                }
                if !entry.hidden: Rectangle {
                    height: 28px;
                    background: entry.enabled && item.has-hover ? Theme.hover-tint : transparent;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 10px;
                        Text {
                            horizontal-stretch: 1;
                            text: entry.label;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                            color: !entry.enabled ? Theme.text-disabled
                                : entry.danger ? #f56c6c
                                : item.has-hover ? Theme.accent : Theme.text-primary;
                        }
                        // Chevron : le caractère « ▸ » ressemblait à un point à cette taille.
                        if entry.submenu: VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("icons/ep-arrow-right.svg");
                                width: 11px;
                                height: 11px;
                                colorize: item.has-hover ? Theme.accent : Theme.text-secondary;
                            }
                        }
                    }
                    item := TouchArea {
                        enabled: entry.enabled;
                        // Comme les menus macOS : le sous-menu s'ouvre au survol, ou au clic.
                        changed has-hover => {
                            if self.has-hover && entry.submenu {
                                root.submenu-y = self.absolute-position.y - root.absolute-position.y;
                                playlists.show();
                            } else if self.has-hover {
                                // Survoler une autre entrée referme le sous-menu.
                                playlists.close();
                            }
                        }
                        clicked => {
                            if entry.submenu {
                                root.submenu-y = self.absolute-position.y - root.absolute-position.y;
                                playlists.show();
                            } else {
                                root.selected(entry.action);
                                root.close();
                            }
                        }
                    }
                }
            }
        }
    }

    playlists := PopupWindow {
        x: root.width - 6px;
        y: root.submenu-y - 5px;
        width: 200px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.footer-bg;
            border-radius: 4px;
            border-width: Theme.hairline;
            border-color: Theme.border-base;
            drop-shadow-blur: 10px;
            drop-shadow-color: #00000066;
            VerticalLayout {
                padding-top: 5px;
                padding-bottom: 5px;
                Rectangle {
                    height: 28px;
                    background: new.has-hover ? Theme.hover-tint : transparent;
                    HorizontalLayout {
                        padding-left: 12px;
                        Text {
                            text: @tr("New Playlist…");
                            font-size: 12px;
                            vertical-alignment: center;
                            color: new.has-hover ? Theme.accent : Theme.text-primary;
                        }
                    }
                    new := TouchArea {
                        clicked => {
                            root.selected("add-to-new-playlist");
                            root.close();
                        }
                    }
                }
                if TrackMenu.playlists.length > 0: Rectangle {
                    height: 9px;
                    Rectangle {
                        height: Theme.hairline;
                        background: Theme.border;
                    }
                }
                for playlist in TrackMenu.playlists: Rectangle {
                    height: 28px;
                    background: pick.has-hover ? Theme.hover-tint : transparent;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 10px;
                        Text {
                            text: playlist.label;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                            color: pick.has-hover ? Theme.accent : Theme.text-primary;
                        }
                    }
                    pick := TouchArea {
                        clicked => {
                            root.selected("add-to-playlist:" + playlist.id);
                            root.close();
                        }
                    }
                }
            }
        }
    }
}

// Entrées des menus contextuels ; les libellés sont formés ici pour @tr.
export global Menus {
    pure public function artist(favorite: bool) -> [MenuEntry] {
        return [
            { action: "enqueue", label: @tr("Add to Queue"), enabled: true },
            { action: "", label: @tr("Add to Playlist"), enabled: true, separated: true, submenu: true },
            { action: "favorite", label: favorite ? @tr("Remove from Favorites") : @tr("Add to Favorites"), enabled: true },
            { action: "rescan", label: @tr("Rescan Audio Tags"), enabled: true, separated: true },
            { action: "edit-tags", label: @tr("Edit Tags…"), enabled: true },
            { action: "delete", label: @tr("Delete from Library…"), enabled: true, separated: true, danger: true },
        ];
    }
    pure public function album(favorite: bool) -> [MenuEntry] {
        return [
            { action: "enqueue", label: @tr("Add to Queue"), enabled: true },
            { action: "show-on-disk", label: @tr("Show on Disk"), enabled: true, separated: true },
            { action: "set-artwork", label: @tr("Set Album Artwork…"), enabled: true },
            { action: "", label: @tr("Add to Playlist"), enabled: true, separated: true, submenu: true },
            { action: "favorite", label: favorite ? @tr("Remove from Favorites") : @tr("Add to Favorites"), enabled: true },
            { action: "rescan", label: @tr("Rescan Audio Tags"), enabled: true, separated: true },
            { action: "edit-tags", label: @tr("Edit Tags…"), enabled: true },
            { action: "delete", label: @tr("Delete from Library…"), enabled: true, separated: true, danger: true },
        ];
    }
    pure public function track(favorite: bool) -> [MenuEntry] {
        return [
            { action: "enqueue", label: @tr("Add to Queue"), enabled: true },
            { action: "show-album", label: @tr("Show Album"), enabled: true, separated: true },
            { action: "show-on-disk", label: @tr("Show on Disk"), enabled: true },
            { action: "", label: @tr("Add to Playlist"), enabled: true, separated: true, submenu: true },
            { action: "favorite", label: favorite ? @tr("Remove from Favorites") : @tr("Add to Favorites"), enabled: true },
            { action: "reset-plays", label: @tr("Reset Play Count"), enabled: true, hidden: !TrackMenu.most-played },
            { action: "rescan", label: @tr("Rescan Audio Tags"), enabled: true, separated: true },
            { action: "edit-tags", label: @tr("Edit Tags…"), enabled: true },
            { action: "remove-from-playlist", label: @tr("Remove from Playlist"), enabled: true, separated: true, hidden: !TrackMenu.in-playlist },
            { action: "delete", label: @tr("Delete from Library…"), enabled: true, separated: true, danger: true, hidden: TrackMenu.in-playlist },
        ];
    }
}

// En-tête de panneau : titre en capitales + pastille de comptage, comme la v0.1.
export component PanelHeader inherits Rectangle {
    in property <string> title;
    in property <string> badge;
    // Panneau qui reçoit les flèches du clavier (Tab pour changer).
    in property <bool> active;
    height: 36px;
    background: Theme.panel-bg;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 8px;
        alignment: start;
        Text {
            text: root.title.to-uppercase();
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.5px;
            color: root.active ? Theme.accent : Theme.text-secondary;
            vertical-alignment: center;
        }
        if root.badge != "": VerticalLayout {
            alignment: center;
            Rectangle {
                height: 16px;
                border-radius: 8px;
                background: Theme.hover-bg;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    Text {
                        text: root.badge;
                        font-size: 9px;
                        color: Theme.accent;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// Jaquette arrondie, avec l'icône dossier de la v0.1 quand l'album n'en a pas.
export component Artwork inherits Rectangle {
    in property <image> source;
    in property <bool> has-image;
    in property <length> size: 40px;
    in property <length> radius: 4px;
    in property <length> icon-size: 16px;
    width: root.size;
    height: root.size;
    border-radius: root.radius;
    clip: true;
    background: Theme.placeholder-bg;

    if root.has-image: Image {
        width: 100%;
        height: 100%;
        source: root.source;
        image-fit: cover;
    }
    if !root.has-image: Image {
        width: root.icon-size;
        height: root.icon-size;
        source: @image-url("icons/folder.svg");
        colorize: Theme.text-tertiary;
    }
}

export component ArtistRow inherits Rectangle {
    in property <ListItem> item;
    in property <bool> selected;
    // Position du curseur clavier (Entrée la sélectionne) : barre gauche en demi-teinte.
    in property <bool> cursor;
    callback clicked();
    callback action(string);
    // Glissé sur une playlist : tous ses morceaux y sont ajoutés.
    pure callback payload() -> data-transfer;
    height: 48px;

    // Angles droits et barre d'accent à gauche, comme les albums et les morceaux.
    Rectangle {
        background: root.selected ? Theme.selected-bg : (root.cursor || touch.has-hover ? Theme.item-hover : transparent);

        Rectangle {
            x: 0;
            width: 3px;
            background: root.selected ? Theme.accent : root.cursor ? Theme.accent.with-alpha(0.5) : transparent;
        }

        VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.item.label;
                font-size: 13px;
                font-weight: 500;
                color: root.selected ? Theme.accent : Theme.text-primary;
                overflow: elide;
            }
            Text {
                text: @tr("{n} album" | "{n} albums" % root.item.count);
                font-size: 11px;
                color: Theme.text-tertiary;
                overflow: elide;
            }
        }
    }

    DragArea {
        allow-copy: true;
        data: root.payload();
        touch := TouchArea {
            clicked => {
                root.clicked();
            }
            // Clic droit : menu au style de l'app, à l'endroit du clic.
            pointer-event(event) => {
                if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                    menu-anchor.x = self.mouse-x;
                    menu-anchor.y = self.mouse-y;
                    menu.show();
                }
            }
        }
        menu-anchor := Rectangle {
            width: 0px;
            height: 0px;
            menu := ThemedMenu {
                entries: Menus.artist(root.item.favorite);
                selected(name) => {
                    root.action(name);
                }
            }
        }
    }
}

export component AlbumRow inherits Rectangle {
    in property <ListItem> item;
    in property <bool> selected;
    in property <bool> cursor;
    callback clicked();
    callback action(string);
    // Glissé sur une playlist : tous ses morceaux y sont ajoutés.
    pure callback payload() -> data-transfer;
    height: 61px;
    background: root.selected ? Theme.selected-bg : (root.cursor || touch.has-hover ? Theme.item-hover : transparent);

    // Sélection : barre d'accent pleine ; curseur clavier : la même en demi-teinte.
    Rectangle {
        x: 0;
        width: 3px;
        background: root.selected ? Theme.accent : root.cursor ? Theme.accent.with-alpha(0.5) : transparent;
    }
    Rectangle {
        y: parent.height - Theme.hairline;
        height: Theme.hairline;
        background: Theme.item-border;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Artwork {
                source: root.item.artwork;
                has-image: root.item.has-artwork;
                size: 40px;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.item.label;
                font-size: 13px;
                font-weight: 500;
                color: root.selected ? Theme.accent : Theme.text-primary;
                overflow: elide;
            }
            Text {
                text: @tr("{n} track" | "{n} tracks" % root.item.count);
                font-size: 11px;
                color: Theme.text-tertiary;
                overflow: elide;
            }
        }
    }

    DragArea {
        allow-copy: true;
        data: root.payload();
        touch := TouchArea {
            clicked => {
                root.clicked();
            }
            // Clic droit : menu au style de l'app, à l'endroit du clic.
            pointer-event(event) => {
                if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                    menu-anchor.x = self.mouse-x;
                    menu-anchor.y = self.mouse-y;
                    menu.show();
                }
            }
        }
        menu-anchor := Rectangle {
            width: 0px;
            height: 0px;
            menu := ThemedMenu {
                entries: Menus.album(root.item.favorite);
                selected(name) => {
                    root.action(name);
                }
            }
        }
    }
}

// Trois barres animées, affichées à la place du numéro du morceau en cours.
export component PlayingIndicator inherits HorizontalLayout {
    in property <bool> animated: true;
    spacing: 2px;
    alignment: end;

    for bar in 3: VerticalLayout {
        alignment: center;
        Rectangle {
            width: 3px;
            border-radius: 1px;
            background: Theme.accent;
            height: root.animated ? 4px + 10px * abs(sin(animation-tick() / 500ms * 180deg + bar * 70deg)) : 6px;
        }
    }
}

// Poignée de redimensionnement verticale entre deux panneaux.
export component Splitter inherits Rectangle {
    in-out property <length> target;
    in property <length> minimum: 120px;
    in property <length> maximum: 600px;
    // Panneau à droite du séparateur (tiroir des tags) : tirer à gauche l'élargit.
    in property <bool> reversed;
    width: 5px;

    Rectangle {
        width: touch.has-hover || touch.pressed ? 3px : Theme.hairline;
        background: touch.has-hover || touch.pressed ? Theme.accent : Theme.border;
    }

    touch := TouchArea {
        mouse-cursor: col-resize;
        moved => {
            root.target = clamp(root.target + (root.reversed ? -1 : 1) * (self.mouse-x - self.pressed-x), root.minimum, root.maximum);
        }
    }
}

// Listes Artistes et Albums : `reveal-serial` change à chaque demande de rendre `reveal-row` visible.
export component ArtistList inherits ListView {
    in property <[ListItem]> items;
    in property <int> selected: -1;
    in property <int> cursor: -1;
    in property <int> reveal-row;
    in property <int> reveal-serial;
    callback clicked(int);
    callback action(int, string);
    pure callback payload(int) -> data-transfer;
    changed reveal-serial => {
        let top = root.reveal-row * 48px;
        if top < -root.content-y {
            root.content-y = -top;
        } else if top + 48px > -root.content-y + root.visible-height {
            root.content-y = -(top + 48px - root.visible-height);
        }
    }

    for artist in root.items: ArtistRow {
        item: artist;
        selected: artist.id == root.selected;
        cursor: artist.id == root.cursor;
        clicked => {
            root.clicked(artist.id);
        }
        action(name) => {
            root.action(artist.id, name);
        }
        payload => {
            return root.payload(artist.id);
        }
    }
}

export component AlbumList inherits ListView {
    in property <[ListItem]> items;
    in property <int> selected: -1;
    in property <int> cursor: -1;
    in property <int> reveal-row;
    in property <int> reveal-serial;
    callback clicked(int);
    callback action(int, string);
    pure callback payload(int) -> data-transfer;
    changed reveal-serial => {
        let top = root.reveal-row * 61px;
        if top < -root.content-y {
            root.content-y = -top;
        } else if top + 61px > -root.content-y + root.visible-height {
            root.content-y = -(top + 61px - root.visible-height);
        }
    }

    for album in root.items: AlbumRow {
        item: album;
        selected: album.id == root.selected;
        cursor: album.id == root.cursor;
        clicked => {
            root.clicked(album.id);
        }
        action(name) => {
            root.action(album.id, name);
        }
        payload => {
            return root.payload(album.id);
        }
    }
}

// Bouton Element Plus taille normale : 32px de haut, rayon 4px.
export component ThemedButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();
    height: 32px;
    min-width: label.preferred-width + 30px;
    border-radius: 4px;
    border-width: Theme.hairline;
    opacity: root.enabled ? 1 : 0.5;
    border-color: root.primary ? Theme.accent : touch.has-hover && root.enabled ? Theme.accent : Theme.button-border;
    background: root.primary ? (touch.has-hover && root.enabled ? Theme.accent-light-3 : Theme.accent)
        : touch.has-hover && root.enabled ? Theme.hover-tint : Theme.button-bg;

    label := Text {
        text: root.text;
        font-size: 14px;
        color: root.primary ? Theme.on-accent : touch.has-hover && root.enabled ? Theme.accent : Theme.button-text;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}
