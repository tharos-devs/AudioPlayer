import { Theme } from "theme.slint";

export struct EqualizerPreset {
    name: string,
    gains: [float],
}

// Nom affiché d'un préréglage ; le nom anglais reste l'identifiant enregistré.
global PresetNames {
    pure public function label(name: string) -> string {
        return name == "Custom" ? @tr("Custom") : name == "Flat" ? @tr("Flat") : name == "Rock" ? @tr("Rock")
            : name == "Pop" ? @tr("Pop") : name == "Jazz" ? @tr("Jazz") : name == "Classical" ? @tr("Classical")
            : name == "Electronic" ? @tr("Electronic") : name == "Hip Hop" ? @tr("Hip Hop")
            : name == "Acoustic" ? @tr("Acoustic") : name;
    }
}

// Réglages de l'égaliseur, lus par Rust pour la chaîne audio et enregistrés dans les réglages.
export global EqualizerState {
    in-out property <bool> enabled: false;
    in-out property <string> preset: "Custom";
    in-out property <[float]> gains: [0, 0, 0, 0, 0, 0, 0];
    out property <[int]> frequencies: [60, 170, 310, 600, 1000, 3000, 6000];
    out property <[EqualizerPreset]> presets: [
        { name: "Flat", gains: [0, 0, 0, 0, 0, 0, 0] },
        { name: "Rock", gains: [3, 1, -1, 1, 2, 4, 3] },
        { name: "Pop", gains: [2, 1, -1, 0, 2, 3, 2] },
        { name: "Jazz", gains: [2, 1, 1, -1, 0, 1, 2] },
        { name: "Classical", gains: [3, -1, -2, 0, 2, 3, 2] },
        { name: "Electronic", gains: [4, 1, -2, 2, 1, 2, 3] },
        { name: "Hip Hop", gains: [4, 2, -1, 1, 2, 3, 2] },
        { name: "Acoustic", gains: [3, 1, 0, 1, 2, 2, 1] },
    ];
}

component Switch inherits Rectangle {
    in-out property <bool> checked;
    width: 30px;
    height: 16px;
    border-radius: 8px;
    background: root.checked ? Theme.accent : Theme.eq-border;
    animate background { duration: 150ms; }

    Rectangle {
        x: root.checked ? parent.width - self.width - 2px : 2px;
        y: 2px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: #ffffff;
        animate x { duration: 150ms; }
    }
    TouchArea {
        clicked => {
            root.checked = !root.checked;
        }
    }
}

// La valeur vient toujours du parent : le curseur ne fait que signaler `edited`,
// sinon l'affecter couperait la liaison et « reset » ou un préréglage ne le déplacerait plus.
component VerticalSlider inherits Rectangle {
    in property <float> value;
    in property <float> minimum: -12;
    in property <float> maximum: 12;
    in property <float> step: 0.5;
    callback edited(float);
    property <length> knob: 14px * Theme.zoom;
    // Le rail s'arrête 10px avant le bas, comme `bottom: 10px` dans la v0.1.
    property <length> rail: root.height - 10px;
    property <float> ratio: (root.value - root.minimum) / (root.maximum - root.minimum);
    width: max(self.knob, 6px * Theme.zoom);

    Rectangle {
        y: 0;
        width: 6px * Theme.zoom;
        height: root.rail;
        border-radius: 3px;
        background: Theme.eq-runway;
    }
    Rectangle {
        y: root.rail * (1 - root.ratio);
        width: 6px * Theme.zoom;
        height: root.rail * root.ratio;
        border-radius: 3px;
        background: Theme.accent;
    }
    Rectangle {
        y: root.rail * (1 - root.ratio) - root.knob / 2;
        width: root.knob;
        height: root.knob;
        border-radius: root.knob / 2;
        background: Theme.accent;
        border-width: 2px;
        border-color: Theme.eq-knob-border;
        drop-shadow-offset-y: 1px;
        drop-shadow-blur: 3px;
        drop-shadow-color: Theme.dark ? #00000066 : #00000033;
    }

    function set-from(y: length) {
        let raw = root.maximum - clamp(y / root.rail, 0, 1) * (root.maximum - root.minimum);
        let stepped = round(raw / root.step) * root.step;
        if stepped != root.value {
            root.edited(stepped);
        }
    }

    TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.set-from(self.mouse-y);
            }
        }
        moved => {
            if self.pressed {
                root.set-from(self.mouse-y);
            }
        }
    }
}

export component Equalizer inherits Rectangle {
    background: Theme.footer-bg;
    // Hauteur naturelle : la liste défilante au-dessus prend le reste.
    vertical-stretch: 0;

    function format-gain(gain: float) -> string {
        return (gain >= 0 ? "+" : "") + gain;
    }
    function format-frequency(hz: int) -> string {
        return hz >= 1000 ? (hz / 1000) + "k" : hz;
    }

    Rectangle {
        y: 0;
        height: Theme.hairline;
        background: Theme.footer-divider;
    }

    VerticalLayout {
        padding: 8px;
        spacing: 6px * Theme.zoom;

        HorizontalLayout {
            spacing: 6px * Theme.zoom;
            alignment: space-between;

            preset-button := Rectangle {
                width: 130px;
                height: 24px * Theme.zoom;
                border-radius: 4px;
                border-width: Theme.hairline;
                border-color: preset-touch.has-hover ? Theme.eq-border-hover : Theme.eq-border;
                background: Theme.eq-bg;
                HorizontalLayout {
                    padding-left: 8px * Theme.zoom;
                    padding-right: 8px * Theme.zoom;
                    Text {
                        text: PresetNames.label(EqualizerState.preset);
                        font-size: 11px * Theme.zoom;
                        color: Theme.eq-text;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: "▼";
                        font-size: 8px * Theme.zoom;
                        color: Theme.text-disabled;
                        vertical-alignment: center;
                    }
                }
                preset-touch := TouchArea {
                    clicked => {
                        presets-popup.show();
                    }
                }
                presets-popup := PopupWindow {
                    y: parent.height + 2px * Theme.zoom;
                    width: parent.width;
                    Rectangle {
                        background: Theme.popup-bg;
                        border-radius: 4px;
                        border-width: Theme.hairline;
                        border-color: Theme.popup-border;
                        drop-shadow-blur: 16px;
                        drop-shadow-color: Theme.popup-shadow;
                        VerticalLayout {
                            padding-top: 4px;
                            padding-bottom: 4px;
                            for preset in EqualizerState.presets: option := Rectangle {
                                property <bool> current: preset.name == EqualizerState.preset;
                                height: 24px * Theme.zoom;
                                background: self.current ? Theme.tint : item.has-hover ? Theme.eq-dropdown-hover : transparent;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    Text {
                                        text: PresetNames.label(preset.name);
                                        font-size: 11px;
                                        font-weight: option.current ? 500 : 400;
                                        color: option.current || item.has-hover ? Theme.accent : Theme.eq-text;
                                        vertical-alignment: center;
                                    }
                                }
                                item := TouchArea {
                                    clicked => {
                                        EqualizerState.preset = preset.name;
                                        // Copie : modifier une bande ne doit pas toucher le préréglage.
                                        EqualizerState.gains = [preset.gains[0], preset.gains[1], preset.gains[2],
                                            preset.gains[3], preset.gains[4], preset.gains[5], preset.gains[6]];
                                    }
                                }
                            }
                        }
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                Switch {
                    checked <=> EqualizerState.enabled;
                }
            }
        }

        HorizontalLayout {
            spacing: 8px * Theme.zoom;
            for frequency[band] in EqualizerState.frequencies: VerticalLayout {
                // Les marges latérales (4px) disparaissent en flex, faute de place à 180px.
                // Largeur égale et indépendante du texte : « +0 » → « -10.5 » ne décale rien.
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                alignment: end;
                // Hors layout : le texte se centre sur la bande sans en imposer la largeur.
                Rectangle {
                    height: gain-label.preferred-height;
                    gain-label := Text {
                        x: (parent.width - self.width) / 2;
                        text: root.format-gain(EqualizerState.gains[band]);
                        font-size: 9px * Theme.zoom;
                        color: Theme.eq-label;
                    }
                }
                Rectangle {
                    height: 12px * Theme.zoom + 8px;
                }
                HorizontalLayout {
                    alignment: center;
                    // La v0.1 multiplie encore ses tailles par le zoom : max(80px, 100px × zoom).
                    VerticalSlider {
                        height: max(80px, 100px * Theme.zoom);
                        value: EqualizerState.gains[band];
                        edited(gain) => {
                            EqualizerState.gains[band] = gain;
                            EqualizerState.preset = "Custom";
                        }
                    }
                }
                Rectangle {
                    height: 8px;
                }
                Rectangle {
                    height: frequency-label.preferred-height;
                    frequency-label := Text {
                        x: (parent.width - self.width) / 2;
                        text: root.format-frequency(frequency);
                        font-size: 8px * Theme.zoom;
                        color: Theme.status-label;
                    }
                }
            }
        }

        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                spacing: 0px;
                reset := Text {
                    text: @tr("reset");
                    font-size: 13px * Theme.zoom;
                    color: reset-touch.has-hover ? Theme.accent-light-3 : Theme.accent;
                    reset-touch := TouchArea {
                        clicked => {
                            EqualizerState.preset = "Flat";
                            EqualizerState.gains = [0, 0, 0, 0, 0, 0, 0];
                        }
                    }
                }
                Rectangle {
                    height: Theme.hairline;
                    background: reset.color;
                }
            }
        }
    }
}
