import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ThemedButton } from "widgets.slint";

// Une ligne du tiroir : `key` désigne le champ (libellé et format choisis ici, pour @tr).
export struct TagRow {
    key: string,
    value: string,
    // Les morceaux sélectionnés n'ont pas tous la même valeur.
    multiple: bool,
    editable: bool,
    // Paire « N of N » (n° de piste ou de disque et son total) : le total, sinon "".
    pair-key: string,
    pair-value: string,
    pair-multiple: bool,
}

// Entrée du menu des champs visibles.
export struct TagChoice {
    key: string,
    shown: bool,
}

global TagLabels {
    pure public function label(key: string) -> string {
        return key == "title" ? @tr("Title") : key == "artist" ? @tr("Artist")
            : key == "album-artist" ? @tr("Album Artist") : key == "album" ? @tr("Album")
            : key == "track-number" ? @tr("Track No.") : key == "disc-number" ? @tr("Disc No.")
            : key == "year" ? @tr("Year") : key == "genre" ? @tr("Genre")
            : key == "composer" ? @tr("Composer") : key == "conductor" ? @tr("Conductor")
            : key == "lyricist" ? @tr("Lyricist") : key == "grouping" ? @tr("Grouping")
            : key == "work" ? @tr("Work") : key == "comment" ? @tr("Comment")
            : key == "publisher" ? @tr("Publisher") : key == "catalog-number" ? @tr("Catalog Number")
            : key == "barcode" ? @tr("Barcode") : key == "disc-subtitle" ? @tr("Disc Subtitle")
            : key == "compilation" ? @tr("Part of a Compilation")
            : key == "technical" ? @tr("Technical Details")
            : key == "codec" ? @tr("File Type") : key == "bitrate" ? @tr("Bitrate")
            : key == "sample-rate" ? @tr("Sample Rate") : key == "bit-depth" ? @tr("Bit Depth")
            : key == "duration" ? @tr("Length") : key == "file-size" ? @tr("File Size") : key;
    }

    // Valeurs brutes envoyées par Rust, mises en forme ici.
    pure public function format(key: string, value: string) -> string {
        if key == "bitrate" { return value + " kbps"; }
        if key == "sample-rate" { return value + " Hz"; }
        if key == "bit-depth" { return value + " bit"; }
        if key == "compilation" { return value == "1" ? @tr("Yes") : @tr("No"); }
        // Comme la v0.1 : 02:44, ou 1:02:44 au-delà d'une heure.
        if key == "duration" {
            let seconds = floor(value.to-float());
            let hours = floor(seconds / 3600);
            let minutes = Math.mod(floor(seconds / 60), 60);
            let rest = Math.mod(seconds, 60);
            return (hours > 0 ? hours + ":" : "") + (minutes < 10 ? "0" : "") + minutes + ":" + (rest < 10 ? "0" : "") + rest;
        }
        if key == "file-size" {
            let bytes = value.to-float();
            return bytes < 1024 ? bytes + " B"
                : bytes < 1048576 ? (bytes / 1024).to-fixed(1) + " KiB"
                : (bytes / 1048576).to-fixed(2) + " MiB";
        }
        return value;
    }
}

// Champ de saisie au style de l'app (le LineEdit standard suit l'accent du système).
export component TagField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    out property <bool> focused: input.has-focus;
    callback edited(string);
    callback accepted();
    callback cancelled();
    height: 26px;
    border-radius: 3px;
    border-width: Theme.hairline;
    border-color: input.has-focus ? Theme.accent : Theme.border-base;
    background: Theme.bg-primary;

    HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        Rectangle {
            if root.text == "" && !input.has-focus: Text {
                x: 0;
                height: 100%;
                text: root.placeholder;
                font-size: 12px;
                font-italic: true;
                color: Theme.text-disabled;
                vertical-alignment: center;
            }
            input := TextInput {
                text <=> root.text;
                font-size: 12px;
                color: Theme.text-primary;
                vertical-alignment: center;
                single-line: true;
                edited => {
                    root.edited(self.text);
                }
                // Entrée enregistre, Échap annule, comme dans les dialogues.
                accepted => {
                    root.accepted();
                }
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        root.cancelled();
                        return accept;
                    }
                    return reject;
                }
            }
        }
    }
}

// Oui / Non (« Part of a Compilation ») ; aucun des deux pour des valeurs multiples.
component Choice inherits HorizontalLayout {
    in property <string> value;
    property <string> chosen: root.value;
    callback edited(string);
    spacing: 6px;
    alignment: start;
    for option in [{ value: "1", label: @tr("Yes") }, { value: "0", label: @tr("No") }]: Rectangle {
        width: 56px;
        height: 24px;
        border-radius: 3px;
        border-width: Theme.hairline;
        border-color: root.chosen == option.value || touch.has-hover ? Theme.accent : Theme.border-base;
        background: root.chosen == option.value ? Theme.tint-strong : touch.has-hover ? Theme.hover-tint : Theme.bg-primary;
        Text {
            text: option.label;
            font-size: 12px;
            color: root.chosen == option.value ? Theme.accent : Theme.text-primary;
        }
        touch := TouchArea {
            clicked => {
                root.chosen = option.value;
                root.edited(option.value);
            }
        }
    }
}

// Genre, comme la v0.1 : saisie libre, et au focus une liste des genres proposés,
// filtrée par ce qui est tapé. La liste est dessinée par le tiroir, par-dessus les
// champs suivants (une PopupWindow prendrait le focus du champ).
component GenreField inherits Rectangle {
    in property <string> value;
    in property <string> placeholder;
    in property <bool> list-open;
    // Genre choisi dans la liste ; `pick-serial` change à chaque choix.
    in property <string> picked;
    in property <int> pick-serial;
    callback edited(string);
    // Coin bas-gauche du champ dans la fenêtre, et sa largeur.
    callback opened(length, length, length);
    callback closed();
    callback accepted();
    callback cancelled();
    property <bool> focused: field.focused;
    height: field.height;

    function open() {
        root.opened(root.absolute-position.x, root.absolute-position.y + (root.height + 2px) * Theme.zoom, root.width);
    }
    changed focused => {
        if self.focused {
            root.open();
        } else {
            root.closed();
        }
    }
    changed pick-serial => {
        field.text = root.picked;
    }

    field := TagField {
        width: 100%;
        text: root.value;
        placeholder: root.placeholder != "" ? root.placeholder : @tr("Genre…");
        edited(text) => {
            root.edited(text);
            if !root.list-open {
                root.open();
            }
        }
        accepted => {
            root.accepted();
        }
        cancelled => {
            if root.list-open {
                root.closed();
            } else {
                root.cancelled();
            }
        }
    }
}

// Petit bouton carré de l'en-tête (crayon, réglages).
component HeaderButton inherits Rectangle {
    in property <image> icon;
    in property <bool> active;
    callback clicked();
    width: 24px;
    height: 24px;
    border-radius: 3px;
    border-width: Theme.hairline;
    border-color: touch.has-hover || root.active ? Theme.accent : Theme.button-border;
    background: touch.has-hover || root.active ? Theme.hover-tint : Theme.button-bg;
    Image {
        source: root.icon;
        width: 13px;
        height: 13px;
        colorize: touch.has-hover || root.active ? Theme.accent : Theme.button-text;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Valeur affichée d'une ligne, paire « 3 of 12 » comprise.
component TagValue inherits Text {
    in property <TagRow> tag;
    property <bool> empty: tag.pair-key == "" ? tag.value == "" : tag.value == "" && tag.pair-value == "";
    text: tag.multiple ? @tr("Multiple values")
        : root.empty ? "—"
        : tag.pair-key == "" ? TagLabels.format(tag.key, tag.value)
        : @tr("{0} of {1}", tag.value == "" ? "—" : tag.value, tag.pair-multiple ? "…" : tag.pair-value == "" ? "—" : tag.pair-value);
    font-size: 12px;
    font-italic: tag.multiple;
    color: tag.multiple || root.empty ? Theme.text-disabled : Theme.text-primary;
    wrap: word-wrap;
}

// Tiroir d'informations (« Track Info » de la v0.1), à droite des morceaux.
export component TagsDrawer inherits Rectangle {
    in property <[TagRow]> rows;
    in property <[TagChoice]> choices;
    in property <[string]> genre-suggestions;
    // Tableau technique du bas (un seul morceau, hors édition), comme la v0.1.
    in property <[TagRow]> technical;
    // Nombre de morceaux affichés.
    in property <int> count;
    in property <bool> editing;
    in property <bool> saving;
    callback edit();
    callback save();
    callback cancel();
    callback value-edited(string, string);
    callback toggle-field(string);
    callback genres-opened();
    property <bool> genre-open;
    property <length> genre-x;
    property <length> genre-y;
    property <length> genre-width;
    property <string> genre-picked;
    property <int> genre-serial;
    changed editing => {
        root.genre-open = false;
    }
    background: Theme.panel-bg;

    VerticalLayout {
        Rectangle {
            height: 36px;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 8px;
                spacing: 6px;
                Text {
                    horizontal-stretch: 1;
                    text: (root.saving ? @tr("Saving Tags…")
                        : root.editing ? @tr("Edit Tags")
                        : root.count <= 1 ? @tr("Track Info")
                        : @tr("{n} track selected" | "{n} tracks selected" % root.count));
                    font-size: 12px;
                    font-weight: 600;
                    color: root.editing ? Theme.accent : Theme.text-secondary;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if !root.editing && !root.saving && root.count > 0: VerticalLayout {
                    alignment: center;
                    HeaderButton {
                        icon: @image-url("icons/ep-edit-pen.svg");
                        clicked => {
                            root.edit();
                        }
                    }
                }
                if !root.editing && !root.saving: VerticalLayout {
                    alignment: center;
                    HeaderButton {
                        icon: @image-url("icons/ep-setting.svg");
                        clicked => {
                            fields-menu.show();
                        }
                    }
                }
                if root.editing && !root.saving: VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 6px;
                        ThemedButton {
                            height: 24px;
                            text: @tr("Save");
                            primary: true;
                            clicked => {
                                root.save();
                            }
                        }
                        ThemedButton {
                            height: 24px;
                            text: @tr("Cancel");
                            clicked => {
                                root.cancel();
                            }
                        }
                    }
                }
            }
            Rectangle {
                y: parent.height - Theme.hairline;
                height: Theme.hairline;
                background: Theme.border-base;
            }
        }

        if root.count == 0: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: 8px;
            Text {
                text: "i";
                font-family: "Georgia";
                font-italic: true;
                font-weight: 700;
                font-size: 28px;
                color: Theme.text-disabled;
                horizontal-alignment: center;
            }
            Text {
                text: @tr("Select a track to see its tags");
                font-size: 12px;
                color: Theme.text-tertiary;
                horizontal-alignment: center;
            }
        }

        if root.count > 0: scroll := ScrollView {
            vertical-stretch: 1;
            // Le défilement déplacerait le champ sous la liste : elle se ferme.
            changed viewport-y => {
                root.genre-open = false;
            }
            // Largeur imposée : sans elle, la hauteur d'un texte replié (long commentaire)
            // est calculée pour une seule ligne et le bas est rogné.
            VerticalLayout {
                width: scroll.visible-width;
                alignment: start;
                padding-top: 4px;
                padding-bottom: 4px;
                for row[index] in root.rows: Rectangle {
                    VerticalLayout {
                        padding-top: 5px;
                        padding-bottom: 5px;
                        padding-left: 14px;
                        padding-right: 12px;
                        spacing: 2px;
                        // En édition, les champs non modifiables s'estompent comme dans la v0.1.
                        opacity: root.editing && !row.editable ? 0.55 : 1;
                        Text {
                            text: TagLabels.label(row.key).to-uppercase();
                            font-size: 10px;
                            font-weight: 500;
                            letter-spacing: 0.4px;
                            color: Theme.text-tertiary;
                        }
                        if !(root.editing && row.editable): TagValue {
                            tag: row;
                        }
                        if root.editing && row.editable && row.key == "compilation": Choice {
                            value: row.multiple ? "" : row.value;
                            edited(value) => {
                                root.value-edited(row.key, value);
                            }
                        }
                        if root.editing && row.editable && row.key == "genre": GenreField {
                            value: row.value;
                            placeholder: row.multiple ? @tr("Multiple values") : "";
                            list-open: root.genre-open;
                            picked: root.genre-picked;
                            pick-serial: root.genre-serial;
                            opened(x, y, width) => {
                                // Les positions absolues sont dans la fenêtre, donc zoomées.
                                root.genre-x = (x - root.absolute-position.x) / Theme.zoom;
                                root.genre-y = (y - root.absolute-position.y) / Theme.zoom;
                                root.genre-width = width;
                                root.genre-open = true;
                                root.genres-opened();
                            }
                            closed => {
                                root.genre-open = false;
                            }
                            edited(value) => {
                                root.value-edited(row.key, value);
                            }
                            accepted => {
                                root.save();
                            }
                            cancelled => {
                                root.cancel();
                            }
                        }
                        if root.editing && row.editable && row.pair-key == "" && row.key != "compilation" && row.key != "genre": TagField {
                            text: row.value;
                            placeholder: row.multiple ? @tr("Multiple values") : "";
                            edited(value) => {
                                root.value-edited(row.key, value);
                            }
                            accepted => {
                                root.save();
                            }
                            cancelled => {
                                root.cancel();
                            }
                        }
                        if root.editing && row.editable && row.pair-key != "": HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            TagField {
                                width: 64px;
                                text: row.value;
                                placeholder: row.multiple ? "…" : "";
                                edited(value) => {
                                    root.value-edited(row.key, value);
                                }
                                accepted => {
                                    root.save();
                                }
                                cancelled => {
                                    root.cancel();
                                }
                            }
                            Text {
                                text: @tr("of");
                                font-size: 12px;
                                color: Theme.text-tertiary;
                                vertical-alignment: center;
                            }
                            TagField {
                                width: 64px;
                                text: row.pair-value;
                                placeholder: row.pair-multiple ? "…" : "";
                                edited(value) => {
                                    root.value-edited(row.pair-key, value);
                                }
                                accepted => {
                                    root.save();
                                }
                                cancelled => {
                                    root.cancel();
                                }
                            }
                        }
                    }
                    // Séparateur sous chaque champ, sauf le dernier.
                    if index < root.rows.length - 1: Rectangle {
                        x: 0;
                        y: parent.height - Theme.hairline;
                        width: parent.width;
                        height: Theme.hairline;
                        background: Theme.border;
                    }
                }
            }
        }

        if root.count == 1 && !root.editing && !root.saving && root.technical.length > 0: Rectangle {
            background: Theme.bg-secondary;
            Rectangle {
                y: 0;
                height: Theme.hairline;
                background: Theme.border-base;
            }
            VerticalLayout {
                padding-top: 6px;
                padding-bottom: 8px;
                padding-left: 14px;
                padding-right: 14px;
                for item in root.technical: HorizontalLayout {
                    padding-top: 2px;
                    padding-bottom: 2px;
                    Text {
                        horizontal-stretch: 1;
                        text: TagLabels.label(item.key);
                        font-size: 10px;
                        font-weight: 500;
                        color: Theme.text-tertiary;
                        vertical-alignment: center;
                    }
                    Text {
                        text: item.value == "" ? "—" : TagLabels.format(item.key, item.value);
                        font-size: 11px;
                        color: Theme.text-secondary;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    if root.genre-open: Rectangle {
        x: root.genre-x;
        y: root.genre-y;
        width: root.genre-width;
        height: min(220px, genres.preferred-height + 8px, root.height - self.y - 4px);
        background: Theme.footer-bg;
        border-radius: 4px;
        border-width: Theme.hairline;
        border-color: Theme.border-base;
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #00000080;
        clip: true;
        // Les clics dans la liste ne traversent pas vers les champs dessous.
        TouchArea { }
        Flickable {
            y: 4px;
            height: parent.height - 8px;
            content-height: genres.preferred-height;
            genres := VerticalLayout {
                for genre in root.genre-suggestions: Rectangle {
                    height: 26px;
                    background: genre-item.has-hover ? Theme.hover-tint : transparent;
                    Text {
                        x: 14px;
                        text: genre;
                        font-size: 12px;
                        color: genre-item.has-hover ? Theme.accent : Theme.text-secondary;
                        vertical-alignment: center;
                    }
                    genre-item := TouchArea {
                        clicked => {
                            root.genre-picked = genre;
                            root.genre-serial += 1;
                            root.value-edited("genre", genre);
                            root.genre-open = false;
                        }
                    }
                }
                if root.genre-suggestions.length == 0: Rectangle {
                    height: 28px;
                    Text {
                        x: 14px;
                        text: @tr("No match");
                        font-size: 12px;
                        font-italic: true;
                        color: Theme.text-tertiary;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // Champs visibles, cochés comme dans la v0.1 ; le menu reste ouvert pour en cocher plusieurs.
    fields-menu := PopupWindow {
        x: root.width - self.width - 8px;
        y: 34px;
        width: 210px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.footer-bg;
            border-radius: 4px;
            border-width: Theme.hairline;
            border-color: Theme.border-base;
            drop-shadow-blur: 10px;
            drop-shadow-color: #00000066;
            VerticalLayout {
                padding-top: 5px;
                padding-bottom: 5px;
                for choice in root.choices: Rectangle {
                    height: 26px;
                    background: item.has-hover ? Theme.hover-tint : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 12px;
                                height: 12px;
                                if choice.shown: Image {
                                    source: @image-url("icons/ep-check.svg");
                                    width: 12px;
                                    height: 12px;
                                    colorize: Theme.accent;
                                }
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: TagLabels.label(choice.key);
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                            color: item.has-hover ? Theme.accent : Theme.text-primary;
                        }
                    }
                    item := TouchArea {
                        clicked => {
                            root.toggle-field(choice.key);
                        }
                    }
                }
            }
        }
    }
}
