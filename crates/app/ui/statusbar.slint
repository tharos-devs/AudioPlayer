import { Theme } from "theme.slint";

// Bouton carré 24px de la barre d'état ; plein d'accent quand il est actif.
component SquareButton inherits Rectangle {
    in property <image> icon;
    in property <string> glyph;
    in property <bool> active;
    in property <angle> icon-rotation: 0deg;
    callback clicked();
    // Bouton à icône seule : rôle et libellé pour VoiceOver et les autres lecteurs d'écran.
    in property <string> label;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.clicked();
    }
    width: 24px;
    height: 24px;
    border-radius: 4px;
    border-width: Theme.hairline;
    border-color: root.active || touch.has-hover ? Theme.accent : Theme.border-base;
    background: root.active ? Theme.accent : touch.has-hover ? Theme.hover-tint : Theme.library-button-bg;
    property <color> foreground: root.active ? Theme.text-inverse : touch.has-hover ? Theme.accent : Theme.status-text;

    if root.glyph == "": Image {
        source: root.icon;
        width: 14px;
        height: 14px;
        colorize: root.foreground;
        transform-rotation: root.icon-rotation;
    }
    if root.glyph != "": Text {
        text: root.glyph;
        font-family: "Georgia";
        font-italic: true;
        font-weight: 700;
        font-size: 13px;
        color: root.foreground;
    }
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component ZoomSlider inherits Rectangle {
    // Suit la valeur reçue, sauf pendant un glissement (`shown` affiche alors la valeur tirée) :
    // une liaison à double sens serait rompue au premier glissement.
    in property <float> value;
    in property <float> minimum;
    in property <float> maximum;
    out property <float> shown: root.dragging ? root.dragged : root.value;
    property <bool> dragging;
    property <float> dragged;
    // Appliquer le zoom redimensionne le curseur sous la souris : on attend le relâchement.
    callback released(float);
    property <float> ratio: (root.shown - root.minimum) / (root.maximum - root.minimum);
    width: 60px;
    height: 16px;

    Rectangle {
        height: 4px;
        border-radius: 2px;
        background: Theme.eq-runway;
    }
    Rectangle {
        x: 0;
        width: parent.width * root.ratio;
        height: 4px;
        border-radius: 2px;
        background: Theme.accent;
    }
    Rectangle {
        x: parent.width * root.ratio - self.width / 2;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.accent;
        border-width: 2px;
        border-color: Theme.eq-knob-border;
    }

    function set-from(x: length) {
        // Pas de 0.01, comme le curseur 70–90 de la v0.1.
        let value = root.minimum + clamp(x / root.width, 0, 1) * (root.maximum - root.minimum);
        root.dragged = round(value * 100) / 100;
    }

    TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.dragging = true;
                root.set-from(self.mouse-x);
            } else if event.kind == PointerEventKind.up {
                root.dragging = false;
                root.released(root.dragged);
            }
        }
        moved => {
            if self.pressed {
                root.set-from(self.mouse-x);
            }
        }
    }
}

export enum StatusSource { library, playlist, recent, none }

export component StatusBar inherits Rectangle {
    in property <StatusSource> source;
    in property <string> source-name;
    in property <int> artists;
    in property <int> albums;
    in property <int> tracks;
    in property <string> message;
    in property <string> version;
    property <float> zoom-min: Theme.zoom-min;
    property <float> zoom-max: Theme.zoom-max;
    in-out property <bool> show-equalizer;
    in-out property <bool> show-tags;
    // Vue du tiroir de droite : 0 = infos et tags du morceau, 1 = « Up Next ».
    in-out property <int> drawer-tab;
    callback tags-toggled();
    callback mini-player();
    callback zoom-edited(float);
    callback toggle-theme();
    // Chemin de la base, affiché à la place de la barre par l'icône de gauche.
    in property <string> database-path;
    in-out property <bool> show-path;
    callback path-closed();
    // Scan ou vérification en cours : bouton d'arrêt devant le message de progression.
    in property <bool> scanning;
    callback stop-scan();

    height: 44px;
    background: Theme.status-bg;

    Rectangle {
        y: 0;
        height: Theme.hairline;
        background: Theme.status-border;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 1px;
        spacing: 8px;

        // Icône de la base : bascule entre la barre et le chemin du fichier .db.
        VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("icons/ep-coin.svg");
                width: 14px;
                height: 14px;
                colorize: root.show-path || db-touch.has-hover ? Theme.accent : Theme.status-text;
                db-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.show-path = !root.show-path;
                        if !root.show-path {
                            root.path-closed();
                        }
                    }
                }
            }
        }

        // Sélectionnable à la souris et copiable (Cmd+C), pour le Terminal ou le Finder.
        if root.show-path: TextInput {
            text: root.database-path;
            read-only: true;
            single-line: true;
            font-size: 12px;
            color: Theme.status-text;
            selection-background-color: Theme.tint-strong;
            selection-foreground-color: Theme.text-primary;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        if !root.show-path && root.scanning: VerticalLayout {
            alignment: center;
            Rectangle {
                height: 22px;
                width: stop-row.preferred-width + 16px;
                border-radius: 4px;
                border-width: Theme.hairline;
                border-color: stop-touch.has-hover ? Theme.accent : Theme.border-base;
                background: stop-touch.has-hover ? Theme.hover-tint : Theme.library-button-bg;
                stop-row := HorizontalLayout {
                    x: 8px;
                    spacing: 5px;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("icons/stop.svg");
                            width: 11px;
                            height: 11px;
                            colorize: stop-touch.has-hover ? Theme.accent : Theme.status-text;
                        }
                    }
                    Text {
                        text: @tr("Stop");
                        font-size: 11px;
                        color: stop-touch.has-hover ? Theme.accent : Theme.status-text;
                        vertical-alignment: center;
                    }
                }
                stop-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.stop-scan();
                    }
                }
            }
        }

        // Message temporaire (scan, etc.) : remplace les trois colonnes.
        if !root.show-path && root.message != "": Text {
            text: root.message;
            font-size: 12px;
            color: Theme.status-text;
            vertical-alignment: center;
            overflow: elide;
        }

        if !root.show-path && root.message == "": HorizontalLayout {
            HorizontalLayout {
                horizontal-stretch: 1;
                alignment: start;
                Text {
                    text: root.source == StatusSource.library ? @tr("Library: {0}", root.source-name)
                        : root.source == StatusSource.recent ? @tr("Playlist: Last added")
                        : root.source == StatusSource.playlist ? @tr("Playlist: {0}", root.source-name)
                        : @tr("No library selected");
                    font-size: 12px;
                    color: Theme.status-text;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            Text {
                horizontal-stretch: 1;
                text: @tr("{n} artist" | "{n} artists" % root.artists) + " • "
                    + @tr("{n} album" | "{n} albums" % root.albums) + " • "
                    + @tr("{n} track" | "{n} tracks" % root.tracks);
                font-size: 12px;
                color: Theme.status-text;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
            HorizontalLayout {
                horizontal-stretch: 1;
                alignment: end;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: @tr("Zoom");
                        min-width: 32px;
                        font-size: 11px;
                        color: Theme.status-label;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                    VerticalLayout {
                        alignment: center;
                        zoom-slider := ZoomSlider {
                            value: Theme.zoom;
                            minimum: root.zoom-min;
                            maximum: root.zoom-max;
                            released(value) => {
                                Theme.zoom = value;
                                root.zoom-edited(value);
                            }
                        }
                    }
                    // 0.7 → 70 %, 0.9 → 100 %, comme la v0.1.
                    Text {
                        // Suit le glissement ; Theme.zoom ne change qu'au relâchement.
                        text: round(70 + (zoom-slider.shown - root.zoom-min) / (root.zoom-max - root.zoom-min) * 30) + "%";
                        min-width: 32px;
                        font-size: 11px;
                        color: Theme.status-label;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    SquareButton {
                        icon: Theme.dark ? @image-url("icons/ep-moon.svg") : @image-url("icons/ep-sunny.svg");
                        label: Theme.dark ? @tr("Light Theme") : @tr("Dark Theme");
                        clicked => {
                            root.toggle-theme();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    SquareButton {
                        icon: @image-url("icons/ep-operation.svg");
                        label: @tr("Equalizer");
                        icon-rotation: 90deg;
                        active: root.show-equalizer;
                        clicked => {
                            root.show-equalizer = !root.show-equalizer;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    SquareButton {
                        icon: @image-url("icons/ep-files.svg");
                        label: @tr("Mini Player");
                        clicked => {
                            root.mini-player();
                        }
                    }
                }
                // « Up Next » et infos du morceau partagent le tiroir de droite : chaque bouton
                // affiche sa vue, un second clic le referme.
                VerticalLayout {
                    alignment: center;
                    SquareButton {
                        icon: @image-url("icons/queue.svg");
                        label: @tr("Up Next");
                        active: root.show-tags && root.drawer-tab == 1;
                        clicked => {
                            root.show-tags = !(root.show-tags && root.drawer-tab == 1);
                            root.drawer-tab = 1;
                            root.tags-toggled();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    SquareButton {
                        glyph: "i";
                        label: @tr("Track Info");
                        active: root.show-tags && root.drawer-tab == 0;
                        clicked => {
                            root.show-tags = !(root.show-tags && root.drawer-tab == 0);
                            root.drawer-tab = 0;
                            root.tags-toggled();
                        }
                    }
                }
                Text {
                    text: "v" + root.version;
                    font-size: 11px;
                    color: Theme.status-label;
                    opacity: 0.7;
                    vertical-alignment: center;
                }
            }
        }
    }
}
