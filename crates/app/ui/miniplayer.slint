import { Theme } from "theme.slint";
import { RoundButton, Slider } from "controlbar.slint";

// Bouton de la colonne de droite : retour à la fenêtre principale, fermeture.
component WindowButton inherits Rectangle {
    in property <image> icon;
    in property <color> hover-color;
    callback clicked();
    background: touch.has-hover ? root.hover-color : Theme.mini-overlay-bg;
    Image {
        source: root.icon;
        width: 15px;
        height: 15px;
        colorize: touch.has-hover && root.hover-color == Theme.mini-close-bg ? #ffffff : Theme.mini-overlay-text;
    }
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Mini-lecteur de la v0.1 : petite fenêtre sans cadre, toujours au premier plan,
// dessinée au zoom fixe de 70 % comme l'original.
export component MiniPlayerWindow inherits Window {
    title: "AudioPlayer";
    no-frame: true;
    always-on-top: true;
    width: 320px;
    height: 35px;
    background: Theme.mini-bg;
    default-font-size: 12px;
    default-font-family: "Verdana";

    in property <string> track-title;
    in property <bool> has-track;
    in property <bool> playing;
    in property <int> position;
    in property <int> duration;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in-out property <float> volume: 70;
    in-out property <bool> muted;
    callback previous();
    callback next();
    callback toggle-play();
    callback seek(float);
    callback volume-edited();
    callback restore();
    // Appui sur la poignée ou le titre : déplacement natif de la fenêtre.
    callback start-move();
    callback quit();
    property <float> volume-before-mute: 70;
    property <float> zoom: 0.7;

    Rectangle {
        x: 0;
        y: 0;
        width: root.width / root.zoom;
        height: root.height / root.zoom;
        transform-scale: root.zoom;
        transform-origin: { x: 0px, y: 0px };

        HorizontalLayout {
            // Poignée de déplacement (la fenêtre n'a pas de barre de titre).
            Rectangle {
                width: 20px;
                background: Theme.mini-handle-bg;
                Rectangle {
                    x: parent.width - Theme.hairline;
                    width: Theme.hairline;
                    background: Theme.mini-handle-border;
                }
                // Poignée « ⋮⋮ » : deux colonnes de trois points.
                for dot[i] in 6: Rectangle {
                    x: parent.width / 2 + (Math.mod(i, 2) == 0 ? -4.5px : 1.5px);
                    y: parent.height / 2 - 7px + floor(i / 2) * 5px;
                    width: 3px;
                    height: 3px;
                    border-radius: 1.5px;
                    background: Theme.mini-handle-dots;
                }
                TouchArea {
                    mouse-cursor: move;
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                            root.start-move();
                        }
                    }
                }
            }

            HorizontalLayout {
                horizontal-stretch: 1;
                padding-left: 12px;
                padding-right: 12px;
                spacing: 12px;

                VerticalLayout {
                    alignment: center;
                    RoundButton {
                        icon: @image-url("icons/ep-arrow-left.svg");
                        enabled: root.has-track;
                        clicked => {
                            root.previous();
                        }
                    }
                }

                // Titre défilant quand il ne tient pas, au-dessus de la progression.
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    padding-top: 5px;
                    spacing: 4px;
                    title-box := Rectangle {
                        height: 18px;
                        clip: true;
                        property <length> gap: 40px;
                        property <length> text-width: label.preferred-width;
                        property <bool> scrolling: root.playing && self.text-width > self.width;
                        property <length> offset: self.scrolling
                            ? Math.mod(animation-tick() / 1ms * 0.03, (self.text-width + self.gap) / 1px) * 1px : 0px;
                        label := Text {
                            x: title-box.scrolling ? -title-box.offset : max(0px, (title-box.width - self.width) / 2);
                            width: title-box.scrolling ? title-box.text-width : min(title-box.text-width, title-box.width);
                            text: root.has-track ? root.track-title : @tr("No track selected");
                            font-size: 13px;
                            font-weight: 500;
                            color: Theme.player-info-text;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        if title-box.scrolling: Text {
                            x: label.x + title-box.text-width + title-box.gap;
                            text: label.text;
                            font-size: 13px;
                            font-weight: 500;
                            color: Theme.player-info-text;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                    root.start-move();
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: root.position-text;
                            min-width: 32px;
                            font-size: 10px;
                            font-weight: 500;
                            color: Theme.player-title;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 12px;
                            Rectangle {
                                height: 6px;
                                border-radius: 3px;
                                border-width: Theme.hairline;
                                border-color: Theme.player-box-border;
                                background: progress.has-hover ? Theme.progress-hover : Theme.progress-bg;
                            }
                            Rectangle {
                                x: 0;
                                height: 6px;
                                border-radius: 3px;
                                width: root.duration > 0 ? parent.width * root.position / root.duration : 0px;
                                background: Theme.accent;
                            }
                            progress := TouchArea {
                                clicked => {
                                    root.seek(self.mouse-x / self.width);
                                }
                            }
                        }
                        Text {
                            text: root.duration-text;
                            min-width: 32px;
                            font-size: 10px;
                            font-weight: 500;
                            color: Theme.player-title;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    RoundButton {
                        icon: @image-url("icons/ep-arrow-right.svg");
                        enabled: root.has-track;
                        clicked => {
                            root.next();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    RoundButton {
                        primary: true;
                        icon: root.playing ? @image-url("icons/ep-video-pause.svg") : @image-url("icons/ep-caret-right.svg");
                        clicked => {
                            root.toggle-play();
                        }
                    }
                }

                // Volume, comme la barre de contrôle : un clic sur l'icône coupe ou rétablit le son.
                HorizontalLayout {
                    spacing: 4px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 16px;
                            height: 16px;
                            opacity: speaker.has-hover ? 1 : 0.7;
                            Image {
                                source: root.muted ? @image-url("icons/speaker.svg") : @image-url("icons/volume.svg");
                                width: 16px;
                                height: 16px;
                                colorize: Theme.dark ? #ffffff : #444444;
                            }
                            if root.muted: Image {
                                source: @image-url("icons/mute-cross.svg");
                                width: 16px;
                                height: 16px;
                            }
                            speaker := TouchArea {
                                clicked => {
                                    if root.muted {
                                        root.muted = false;
                                        root.volume = root.volume-before-mute > 0 ? root.volume-before-mute : 70;
                                    } else {
                                        root.volume-before-mute = root.volume;
                                        root.muted = true;
                                        root.volume = 0;
                                    }
                                    root.volume-edited();
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Slider {
                            width: 80px;
                            value <=> root.volume;
                            edited(value) => {
                                root.muted = value == 0;
                                root.volume-edited();
                            }
                            double-clicked => {
                                root.volume = 70;
                                root.muted = false;
                                root.volume-edited();
                            }
                        }
                    }
                }
            }

            VerticalLayout {
                width: 30px;
                WindowButton {
                    icon: @image-url("icons/mini-up.svg");
                    hover-color: Theme.mini-overlay-hover;
                    clicked => {
                        root.restore();
                    }
                }
                WindowButton {
                    icon: @image-url("icons/mini-close.svg");
                    hover-color: Theme.mini-close-bg;
                    clicked => {
                        root.quit();
                    }
                }
            }
        }
    }
}
