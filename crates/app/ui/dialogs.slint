import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ThemedButton } from "widgets.slint";
import { TagField } from "tags.slint";

export enum NameDialogKind { new-playlist, rename-playlist, rename-library, new-library }

// Saisie d'un nom par-dessus la fenêtre : Entrée valide, Échap annule. Une nouvelle
// bibliothèque demande aussi son dossier racine, choisi par le bouton « Choose… ».
export component NameDialog inherits Rectangle {
    in property <NameDialogKind> kind;
    in-out property <string> text;
    // Le nom proposé est déjà utilisé : la fenêtre reste ouverte.
    in property <bool> taken;
    in property <string> folder;
    // Bibliothèque dont le dossier recoupe celui choisi (vide si aucune).
    in property <string> folder-overlaps;
    callback accepted(string);
    callback cancelled();
    callback choose-folder();
    property <bool> needs-folder: root.kind == NameDialogKind.new-library;
    property <bool> complete: root.text != "" && (!root.needs-folder || (root.folder != "" && root.folder-overlaps == ""));

    background: #00000080;

    public function focus-input() {
        input.focus-input();
    }

    // Absorbe les clics hors de la boîte.
    TouchArea { }

    Rectangle {
        width: root.needs-folder ? 440px : 360px;
        height: layout.preferred-height;
        border-radius: 6px;
        background: Theme.popup-bg;
        border-width: Theme.hairline;
        border-color: Theme.popup-border;
        drop-shadow-blur: 16px;
        drop-shadow-color: Theme.popup-shadow;

        keys := FocusScope {
            key-pressed(event) => {
                // Dialogue modal : Tab ne sort pas vers le champ de recherche derrière lui.
                if event.text == Key.Tab || event.text == Key.Backtab {
                    return accept;
                }
                if event.text == Key.Escape {
                    root.cancelled();
                    return accept;
                }
                return reject;
            }

            layout := VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: root.kind == NameDialogKind.new-playlist ? @tr("New Playlist")
                        : root.kind == NameDialogKind.rename-playlist ? @tr("Rename Playlist")
                        : root.kind == NameDialogKind.new-library ? @tr("New Library")
                        : @tr("Rename Library");
                    font-size: 14px;
                    font-weight: 600;
                    color: Theme.text-primary;
                }
                // Champ aux couleurs du thème (le LineEdit standard suit l'accent bleu du système).
                input := TagField {
                    height: 30px;
                    font-size: 13px;
                    text <=> root.text;
                    placeholder: @tr("Name");
                    accepted => {
                        if root.complete {
                            root.accepted(root.text);
                        }
                    }
                    cancelled => {
                        root.cancelled();
                    }
                }
                if root.taken: Text {
                    text: @tr("This name is already used.");
                    font-size: 11px;
                    color: Theme.danger;
                }
                if root.needs-folder: HorizontalLayout {
                    spacing: 8px;
                    Text {
                        horizontal-stretch: 1;
                        text: root.folder != "" ? root.folder : @tr("No folder chosen");
                        font-size: 12px;
                        color: root.folder != "" ? Theme.text-primary : Theme.text-secondary;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    ThemedButton {
                        text: @tr("Choose…");
                        clicked => {
                            root.choose-folder();
                        }
                    }
                }
                if root.needs-folder && root.folder-overlaps != "": Text {
                    text: @tr("This folder overlaps the folder of the library “{0}”.", root.folder-overlaps);
                    font-size: 11px;
                    color: Theme.danger;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    ThemedButton {
                        text: @tr("Cancel");
                        clicked => {
                            root.cancelled();
                        }
                    }
                    ThemedButton {
                        text: @tr("OK");
                        primary: true;
                        enabled: root.complete;
                        clicked => {
                            root.accepted(root.text);
                        }
                    }
                }
            }
        }
    }
}

export enum ConfirmKind { delete-playlist, delete-library, remove-missing, delete-tracks, delete-selection }

// Confirmation d'une suppression ; Entrée confirme, Échap annule.
export component ConfirmDialog inherits Rectangle {
    in property <ConfirmKind> kind;
    in property <string> subject;
    in property <int> count;
    callback confirmed();
    callback cancelled();

    background: #00000080;

    public function focus-keys() {
        keys.focus();
    }

    TouchArea { }

    Rectangle {
        width: 380px;
        height: layout.preferred-height;
        border-radius: 6px;
        background: Theme.popup-bg;
        border-width: Theme.hairline;
        border-color: Theme.popup-border;
        drop-shadow-blur: 16px;
        drop-shadow-color: Theme.popup-shadow;

        keys := FocusScope {
            key-pressed(event) => {
                // Dialogue modal : Tab ne sort pas vers le champ de recherche derrière lui.
                if event.text == Key.Tab || event.text == Key.Backtab {
                    return accept;
                }
                if event.text == Key.Escape {
                    root.cancelled();
                    return accept;
                }
                if event.text == Key.Return {
                    root.confirmed();
                    return accept;
                }
                return reject;
            }

            layout := VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: root.kind == ConfirmKind.delete-playlist
                        ? @tr("Delete the playlist “{0}”?", root.subject)
                        : root.kind == ConfirmKind.remove-missing
                        ? @tr("{n} track of “{0}” has a missing file" | "{n} tracks of “{0}” have missing files" % root.count, root.subject)
                        : root.kind == ConfirmKind.delete-tracks
                        ? @tr("Delete “{0}” from the library ({n} track)?" | "Delete “{0}” from the library ({n} tracks)?" % root.count, root.subject)
                        : root.kind == ConfirmKind.delete-selection
                        ? @tr("Delete {n} track from the library?" | "Delete {n} tracks from the library?" % root.count)
                        : @tr("Delete the library “{0}”?", root.subject);
                    font-size: 14px;
                    font-weight: 600;
                    color: Theme.text-primary;
                    wrap: word-wrap;
                }
                Text {
                    text: root.kind == ConfirmKind.delete-playlist
                        ? @tr("The tracks stay in the library.")
                        : root.kind == ConfirmKind.remove-missing
                        ? @tr("Remove them from the library? Their play counts, favorites and playlist entries are lost.")
                        : root.kind == ConfirmKind.delete-tracks || root.kind == ConfirmKind.delete-selection
                        ? @tr("Play counts, favorites and playlist entries are lost. The music files are not touched: the next scan of the folder adds them back.")
                        : @tr("Its artists, albums, tracks and playlists are removed from the database. The music files are not touched.");
                    font-size: 12px;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    ThemedButton {
                        text: @tr("Cancel");
                        clicked => {
                            root.cancelled();
                        }
                    }
                    ThemedButton {
                        text: root.kind == ConfirmKind.remove-missing ? @tr("Remove") : @tr("Delete");
                        primary: true;
                        clicked => {
                            root.confirmed();
                        }
                    }
                }
            }
        }
    }
}

// Bilan d'un scan de bibliothèque (« Scan for Changes », « Rescan All Files », « Add Folder… »).
export struct ScanReport {
    library: string,
    stopped: bool,
    tracks-added: int,
    tracks-updated: int,
    tracks-removed: int,
    albums-added: int,
    albums-updated: int,
    albums-removed: int,
    unreadable: int,
    inaccessible: int,
    // Noms « artiste — album », limités ; `more-*` : ceux qui n'y sont pas.
    added-names: [string],
    removed-names: [string],
    more-added: int,
    more-removed: int,
}

component ReportCell inherits Text {
    font-size: 12px;
    color: Theme.text-primary;
    horizontal-alignment: right;
}

component AlbumNames inherits VerticalLayout {
    in property <string> title;
    in property <[string]> names;
    in property <int> more;
    spacing: 4px;
    Text {
        text: root.title;
        font-size: 12px;
        font-weight: 600;
        color: Theme.text-primary;
    }
    ScrollView {
        height: min(root.names.length * 17px + 4px, 150px);
        VerticalLayout {
            padding-right: 12px;
            for name in root.names: Text {
                height: 17px;
                text: name;
                font-size: 12px;
                color: Theme.text-secondary;
                overflow: elide;
            }
        }
    }
    if root.more > 0: Text {
        text: @tr("…and {n} more" | "…and {n} more" % root.more);
        font-size: 11px;
        color: Theme.text-secondary;
    }
}

export component ScanReportDialog inherits Rectangle {
    in property <ScanReport> report;
    callback closed();
    // Arrêté ou incomplet : rien ne dit que la bibliothèque est à jour.
    property <bool> unchanged: root.report.tracks-added + root.report.tracks-updated + root.report.tracks-removed == 0
        && !root.report.stopped && root.report.inaccessible == 0;

    background: #00000080;

    public function focus-keys() {
        keys.focus();
    }

    TouchArea { }

    Rectangle {
        width: 440px;
        height: layout.preferred-height;
        border-radius: 6px;
        background: Theme.popup-bg;
        border-width: Theme.hairline;
        border-color: Theme.popup-border;
        drop-shadow-blur: 16px;
        drop-shadow-color: Theme.popup-shadow;

        keys := FocusScope {
            key-pressed(event) => {
                if event.text == Key.Tab || event.text == Key.Backtab {
                    return accept;
                }
                if event.text == Key.Escape || event.text == Key.Return {
                    root.closed();
                    return accept;
                }
                return reject;
            }

            layout := VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: root.report.stopped ? @tr("Scan of “{0}” stopped", root.report.library)
                        : root.report.inaccessible > 0 ? @tr("Scan of “{0}” incomplete", root.report.library)
                        : @tr("Scan of “{0}” finished", root.report.library);
                    font-size: 14px;
                    font-weight: 600;
                    color: Theme.text-primary;
                    wrap: word-wrap;
                }
                if root.unchanged: Text {
                    text: @tr("No changes: the library is up to date.");
                    font-size: 12px;
                    color: Theme.text-secondary;
                }
                if !root.unchanged: GridLayout {
                    spacing-horizontal: 18px;
                    spacing-vertical: 4px;
                    Row {
                        Text { }
                        ReportCell { text: @tr("Added"); color: Theme.text-secondary; }
                        ReportCell { text: @tr("Updated"); color: Theme.text-secondary; }
                        ReportCell { text: @tr("Removed"); color: Theme.text-secondary; }
                    }
                    Row {
                        ReportCell { text: @tr("Albums"); horizontal-alignment: left; horizontal-stretch: 1; }
                        ReportCell { text: root.report.albums-added; }
                        ReportCell { text: root.report.albums-updated; }
                        ReportCell { text: root.report.albums-removed; }
                    }
                    Row {
                        ReportCell { text: @tr("Tracks"); horizontal-alignment: left; horizontal-stretch: 1; }
                        ReportCell { text: root.report.tracks-added; }
                        ReportCell { text: root.report.tracks-updated; }
                        ReportCell { text: root.report.tracks-removed; }
                    }
                }
                if root.report.added-names.length > 0: AlbumNames {
                    title: @tr("New albums");
                    names: root.report.added-names;
                    more: root.report.more-added;
                }
                if root.report.removed-names.length > 0: AlbumNames {
                    title: @tr("Removed albums");
                    names: root.report.removed-names;
                    more: root.report.more-removed;
                }
                if root.report.stopped: Text {
                    text: @tr("The next scan picks up where this one stopped.");
                    font-size: 11px;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                if root.report.inaccessible > 0: Text {
                    text: @tr("{n} file or folder could not be read (disk disconnected?): nothing was removed from it." | "{n} files or folders could not be read (disk disconnected?): nothing was removed from them." % root.report.inaccessible);
                    font-size: 11px;
                    color: Theme.danger;
                    wrap: word-wrap;
                }
                if root.report.unreadable > 0: Text {
                    text: @tr("{n} file has unreadable tags." | "{n} files have unreadable tags." % root.report.unreadable);
                    font-size: 11px;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    ThemedButton {
                        text: @tr("OK");
                        primary: true;
                        clicked => {
                            root.closed();
                        }
                    }
                }
            }
        }
    }
}
