import { Theme } from "theme.slint";
import { ThemedButton } from "widgets.slint";

// Problèmes rencontrés en créant ou en ouvrant une base ; le texte est formé ici pour @tr.
export enum DatabaseProblem { none, already-exists, legacy-file, too-new, unknown-file, failed }

export global DatabaseProblems {
    pure public function describe(problem: DatabaseProblem, path: string, detail: string) -> string {
        return problem == DatabaseProblem.already-exists ? @tr("“{0}” already exists. Choose a new file name.", path)
            : problem == DatabaseProblem.legacy-file ? @tr("“{0}” is a v0.1 database. Convert it first with the import-v01 command (see the README).", path)
            : problem == DatabaseProblem.too-new ? @tr("“{0}” was created by a newer version of AudioPlayer.", path)
            : problem == DatabaseProblem.unknown-file ? @tr("“{0}” is not an AudioPlayer database.", path)
            : problem == DatabaseProblem.failed ? @tr("Could not use “{0}”: {1}", path, detail)
            : "";
    }
}

// Premier lancement, ou base introuvable : créer ou ouvrir une base.
export component SetupWindow inherits Window {
    title: "AudioPlayer";
    icon: @image-url("icons/app.png");
    width: 600px;
    height: 400px;
    background: Theme.bg-secondary;
    default-font-family: "Verdana";

    // Chemin enregistré mais introuvable (disque externe débranché…) ; vide au premier lancement.
    in property <string> missing-path;
    in property <DatabaseProblem> problem;
    in property <string> problem-path;
    in property <string> problem-detail;
    callback create-database();
    callback open-database();
    callback retry();

    VerticalLayout {
        padding: 32px;
        spacing: 16px;
        alignment: center;

        HorizontalLayout {
            alignment: center;
            Image {
                source: root.missing-path == "" ? @image-url("icons/ep-document.svg") : @image-url("icons/ep-warning.svg");
                width: 48px;
                height: 48px;
                colorize: root.missing-path == "" ? Theme.accent : #e6a23c;
            }
        }
        Text {
            text: root.missing-path == "" ? @tr("Welcome to AudioPlayer!") : @tr("Database not found");
            font-size: 20px;
            font-weight: 600;
            color: Theme.text-primary;
            horizontal-alignment: center;
        }
        Text {
            text: root.missing-path == ""
                ? @tr("Choose where to keep your music library database, for example on an external drive. Your settings are stored in it too.")
                : @tr("The database “{0}” cannot be found. If it is on an external drive, connect the drive and retry.", root.missing-path);
            font-size: 13px;
            color: Theme.text-secondary;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        VerticalLayout {
            spacing: 10px;
            padding-top: 8px;
            if root.missing-path != "": HorizontalLayout {
                alignment: center;
                ThemedButton {
                    width: 300px;
                    text: @tr("Retry");
                    primary: true;
                    clicked => {
                        root.retry();
                    }
                }
            }
            HorizontalLayout {
                alignment: center;
                ThemedButton {
                    width: 300px;
                    text: @tr("Create Database…");
                    primary: root.missing-path == "";
                    clicked => {
                        root.create-database();
                    }
                }
            }
            HorizontalLayout {
                alignment: center;
                ThemedButton {
                    width: 300px;
                    text: @tr("Open Database…");
                    clicked => {
                        root.open-database();
                    }
                }
            }
        }

        if root.problem != DatabaseProblem.none: Text {
            text: DatabaseProblems.describe(root.problem, root.problem-path, root.problem-detail);
            font-size: 12px;
            color: Theme.danger;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}
