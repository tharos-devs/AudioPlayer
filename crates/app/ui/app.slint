import { ListView, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ListItem, PanelHeader, ArtistList, AlbumList, Splitter } from "widgets.slint";
import { TrackItem, TrackItemKind, TrackList, PlaylistTrackList, TrackMenu } from "tracks.slint";
import { NameDialog, NameDialogKind, ConfirmDialog, ConfirmKind } from "dialogs.slint";
import { Sidebar, View } from "sidebar.slint";
import { ControlBar } from "controlbar.slint";
import { StatusBar, StatusSource } from "statusbar.slint";
import { EqualizerState } from "equalizer.slint";
import { SetupWindow, DatabaseProblem, DatabaseProblems } from "setup.slint";
import { TagsDrawer, TagRow, TagChoice } from "tags.slint";

export { Theme, ListItem, TrackItem, TrackItemKind, View, StatusSource, EqualizerState, SetupWindow, DatabaseProblem, TrackMenu, NameDialogKind, ConfirmKind, TagRow, TagChoice }

export enum StatusKind { summary, added-to-playlist, already-in-playlist, enqueued, selection-added, selection-already-in-playlist, selection-enqueued, selection-favorited, selection-unfavorited, tracks-added, scan-listing, scan-reading, scan-finished, scan-stopped, scan-root-missing, scan-root-empty, scan-failed, library-healthy, folder-in-library, database-problem, playback-failed, no-output, favorite-added, favorite-removed, tags-writing, tags-saved, tags-failed, tags-invalid, artwork-saved }

// Les messages d'état sont formatés ici (et non en Rust) pour passer par @tr.
export struct Status {
    kind: StatusKind,
    track: string,
    playlist: string,
    problem: DatabaseProblem,
    count: int,
    total: int,
    removed: int,
}

export component AppWindow inherits Window {
    title: "AudioPlayer";
    // Barre des tâches sous Windows et Linux ; sur macOS, l'icône vient du paquet .app.
    icon: @image-url("icons/app.png");
    preferred-width: 1360px;
    preferred-height: 820px;
    min-width: 900px;
    min-height: 500px;
    background: Theme.bg-primary;
    default-font-size: 12px;
    // Choix de l'utilisateur ; livrée avec macOS et Windows, sinon police de repli.
    default-font-family: "Verdana";

    in property <[ListItem]> libraries;
    in-out property <int> selected-library: -1;
    in property <View> view;
    in property <string> letter;
    in property <int> most-played-count;
    in property <int> favorite-artists-count;
    in property <int> favorite-albums-count;
    in property <int> favorite-tracks-count;
    in property <string> library-name;
    in property <int> library-artists;
    in property <int> library-albums;
    in property <string> version;
    in-out property <bool> show-equalizer: true;
    in-out property <bool> search-visible;
    in-out property <bool> random-mode;
    in-out property <bool> loop-mode;
    in-out property <float> volume: 70;
    in-out property <bool> muted;
    in property <[ListItem]> artists;
    in property <[ListItem]> albums;
    in property <[ListItem]> playlists;
    in property <[TrackItem]> track-items;
    in property <[TrackItem]> playlist-items;
    in-out property <int> selected-artist: -1;
    in-out property <int> selected-album: -1;
    in-out property <int> selected-playlist: -1;
    in-out property <int> selected-track: -1;
    in property <string> playlist-name;
    in property <int> library-count;
    in property <int> artists-count;
    in property <int> albums-count;
    in property <int> tracks-count;
    in property <int> tracks-duration;

    in property <int> playing-track: -1;
    in property <bool> playing;
    in property <string> now-title;
    in property <string> now-artist;
    in property <image> now-artwork;
    in property <bool> now-has-artwork;
    in property <int> position;
    in property <int> duration;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <string> remaining-text: "-0:00";

    in property <Status> status;
    property <string> status-text: root.status.kind == StatusKind.added-to-playlist
        ? @tr("“{0}” added to “{1}”", root.status.track, root.status.playlist)
        : root.status.kind == StatusKind.already-in-playlist
        ? @tr("“{0}” is already in “{1}”", root.status.track, root.status.playlist)
        : root.status.kind == StatusKind.enqueued
        ? @tr("“{0}” added to the queue", root.status.track)
        : root.status.kind == StatusKind.scan-listing
        ? @tr("Scanning “{0}”: {1} folders…", root.status.track, root.status.count)
        : root.status.kind == StatusKind.scan-reading
        ? @tr("Scanning “{0}”: {1} / {2} files — {3}", root.status.track, root.status.count, root.status.total, root.status.playlist)
        : root.status.kind == StatusKind.scan-finished
        ? @tr("Scan of “{0}” finished: {1} added, {2} updated, {3} removed", root.status.track, root.status.count, root.status.total, root.status.removed)
        : root.status.kind == StatusKind.scan-stopped
        ? @tr("Scan of “{0}” stopped: {1} added, {2} updated so far", root.status.track, root.status.count, root.status.total)
        : root.status.kind == StatusKind.scan-root-missing
        ? @tr("Folder of “{0}” not found: {1}. Nothing was changed.", root.status.track, root.status.playlist)
        : root.status.kind == StatusKind.scan-root-empty
        ? @tr("No audio file found in {1}: “{0}” was left unchanged.", root.status.track, root.status.playlist)
        : root.status.kind == StatusKind.scan-failed
        ? @tr("Scan of “{0}” failed: {1}", root.status.track, root.status.playlist)
        : root.status.kind == StatusKind.library-healthy
        ? @tr("“{0}” is healthy: every file is present.", root.status.track)
        : root.status.kind == StatusKind.folder-in-library
        ? @tr("{0} overlaps the folder of the library “{1}”.", root.status.track, root.status.playlist)
        : root.status.kind == StatusKind.tracks-added
        ? @tr("{n} track of “{0}” added to “{1}”" | "{n} tracks of “{0}” added to “{1}”" % root.status.count, root.status.track, root.status.playlist)
        : root.status.kind == StatusKind.selection-added
        ? @tr("{n} track added to “{0}”" | "{n} tracks added to “{0}”" % root.status.count, root.status.playlist)
        : root.status.kind == StatusKind.selection-already-in-playlist
        ? @tr("These tracks are already in “{0}”", root.status.playlist)
        : root.status.kind == StatusKind.selection-enqueued
        ? @tr("{n} track added to the queue" | "{n} tracks added to the queue" % root.status.count)
        : root.status.kind == StatusKind.selection-favorited
        ? @tr("{n} track added to favorites" | "{n} tracks added to favorites" % root.status.count)
        : root.status.kind == StatusKind.selection-unfavorited
        ? @tr("{n} track removed from favorites" | "{n} tracks removed from favorites" % root.status.count)
        : root.status.kind == StatusKind.favorite-added
        ? @tr("“{0}” added to favorites", root.status.track)
        : root.status.kind == StatusKind.favorite-removed
        ? @tr("“{0}” removed from favorites", root.status.track)
        : root.status.kind == StatusKind.playback-failed
        ? @tr("Cannot play “{0}”: {1}", root.status.track, root.status.playlist)
        : root.status.kind == StatusKind.no-output
        ? @tr("No audio output: {0}", root.status.playlist)
        : root.status.kind == StatusKind.tags-writing
        ? @tr("Writing tags: {0} / {1} files…", root.status.count, root.status.total)
        : root.status.kind == StatusKind.tags-saved
        ? @tr("Tags saved in {n} file" | "Tags saved in {n} files" % root.status.count)
        : root.status.kind == StatusKind.artwork-saved
        ? @tr("Artwork saved in {n} file" | "Artwork saved in {n} files" % root.status.count)
        : root.status.kind == StatusKind.tags-failed
        ? @tr("{n} file could not be written: “{0}”: {1}" | "{n} files could not be written, including “{0}”: {1}" % root.status.count, root.status.track, root.status.playlist)
        : root.status.kind == StatusKind.tags-invalid
        ? @tr("“{0}” is not a valid number", root.status.track)
        : root.status.kind == StatusKind.database-problem
        ? DatabaseProblems.describe(root.status.problem, root.status.track, root.status.playlist)
        : @tr("{n} track" | "{n} tracks" % root.tracks-count) + " · "
            + @tr("{0} h {1} min", floor(root.tracks-duration / 3600), Math.mod(floor(root.tracks-duration / 60), 60));
    in-out property <string> search-text;

    in-out property <length> artists-width: 255px;
    in-out property <length> albums-width: 300px;
    // Tiroir des tags (bouton « i » de la barre d'état).
    in-out property <bool> tags-open;
    in-out property <length> tags-width: 320px;
    in property <[TagRow]> tag-rows;
    in property <[TagChoice]> tag-choices;
    in property <int> tag-count;
    in property <bool> tags-editing;
    in property <bool> tags-saving;
    callback tags-toggled();
    callback tags-edit();
    callback tags-save();
    callback tags-cancel();
    callback tag-edited(string, string);
    callback tag-field-toggled(string);

    callback select-library(int);
    callback select-letter(string);
    callback select-view(View);
    callback zoom-edited(float);
    callback select-artist(int);
    callback select-album(int);
    callback select-playlist(int);
    callback search(string);
    callback play-track(int);
    callback show-current();
    callback toggle-play();
    callback previous();
    callback next();
    callback seek(float);
    callback seek-by(int);
    // Maj+↑/↓ étend la sélection.
    callback move-selection(int, bool);
    callback track-clicked(int, bool, bool);
    in property <int> reveal-row;
    in property <int> reveal-serial;
    // Navigation clavier : 0 = artistes, 1 = albums, 2 = morceaux.
    in-out property <int> active-panel: 2;
    in property <int> artist-cursor: -1;
    in property <int> album-cursor: -1;
    in property <int> artist-reveal-row;
    in property <int> artist-reveal-serial;
    in property <int> album-reveal-row;
    in property <int> album-reveal-serial;
    callback cycle-panel(int);
    callback library-menu(string);
    callback stop-scan();
    callback playlist-menu(string);
    in property <int> recent-amount: 2;
    in property <string> recent-unit: "weeks";
    callback recent-changed(int, string);
    // Saisie d'un nom (playlist, bibliothèque).
    in-out property <bool> dialog-open;
    in property <NameDialogKind> dialog-kind;
    in-out property <string> dialog-text;
    in property <bool> dialog-taken;
    callback dialog-accepted(string);
    public function open-dialog() {
        root.dialog-open = true;
        name-dialog.focus-input();
    }
    public function close-dialog() {
        root.dialog-open = false;
        keys.focus();
    }
    in-out property <bool> confirm-open;
    in property <ConfirmKind> confirm-kind;
    in property <string> confirm-subject;
    in property <int> confirm-count;
    in property <bool> scanning;
    callback confirm-accepted();
    public function open-confirm() {
        root.confirm-open = true;
        confirm-dialog.focus-keys();
    }
    public function close-confirm() {
        root.confirm-open = false;
        keys.focus();
    }
    callback activate();
    public function focus-keys() {
        keys.focus();
    }
    // Un clic dans la liste des morceaux la rend active.
    changed selected-track => {
        if root.selected-track != -1 {
            root.active-panel = 2;
        }
    }
    callback track-action(int, string);
    callback drop-on-playlist(int, data-transfer);
    pure callback track-payload(int) -> data-transfer;
    pure callback artist-payload(int) -> data-transfer;
    pure callback album-payload(int) -> data-transfer;
    // Morceau, artiste ou album : tout ce qui peut rejoindre une playlist.
    pure callback is-track-payload(data-transfer) -> bool;
    callback artist-action(int, string);
    callback playlist-reorder(data-transfer, int);
    callback album-action(int, string);
    callback select-language(string);
    callback new-database();
    callback open-database();
    in property <string> database-path;
    in-out property <string> language: "en";

    function toggle-theme() {
        Theme.dark = !Theme.dark;
        root.sync-color-scheme();
    }

    // Les widgets standard (défilement, etc.) suivent le thème de l'app.
    public function sync-color-scheme() {
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }

    init => {
        keys.focus();
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }

    MenuBar {
        Menu {
            title: @tr("File");
            MenuItem {
                title: @tr("New Database…");
                activated => {
                    root.new-database();
                }
            }
            MenuItem {
                title: @tr("Open Database…");
                activated => {
                    root.open-database();
                }
            }
        }
        Menu {
            title: @tr("View");
            MenuItem {
                title: Theme.dark ? @tr("Light Theme") : @tr("Dark Theme");
                activated => {
                    root.toggle-theme();
                }
            }
            Menu {
                title: @tr("Language");
                MenuItem {
                    title: "English";
                    checkable: true;
                    checked: root.language == "en";
                    activated => {
                        root.select-language("en");
                    }
                }
                MenuItem {
                    title: "Français";
                    checkable: true;
                    checked: root.language == "fr";
                    activated => {
                        root.select-language("fr");
                    }
                }
            }
        }
    }

    // Zoom global : le contenu est dessiné à 1/zoom de la fenêtre puis réduit,
    // comme le `zoom` CSS ; la fenêtre et son facteur d'échelle ne bougent pas.
    Rectangle {
        x: 0;
        y: 0;
        width: root.width / Theme.zoom;
        height: root.height / Theme.zoom;
        transform-scale: Theme.zoom;
        transform-origin: { x: 0px, y: 0px };

        // Cmd/Ctrl+F affiche la recherche, comme la v0.1. Minuscule exprès : à chaque
        // redimensionnement, Slint fait défiler les listes pour montrer l'élément focalisé,
        // et un FocusScope couvrant tout le contenu zoomé décalait la liste des morceaux.
        //
        // Flèches gauche/droite, comme la v0.1 : appui bref = morceau précédent/suivant ;
        // maintenues plus de 300ms = recul/avance d'une seconde toutes les 100ms.
        keys := FocusScope {
            x: 0;
            y: 0;
            width: 1px;
            height: 1px;
            property <int> held: 0;
            property <bool> seeking;

            hold := Timer {
                interval: 300ms;
                running: false;
                triggered => {
                    self.running = false;
                    keys.seeking = true;
                    root.seek-by(keys.held);
                    repeat.running = true;
                }
            }
            repeat := Timer {
                interval: 100ms;
                running: false;
                triggered => {
                    root.seek-by(keys.held);
                }
            }

            key-pressed(event) => {
                if (event.modifiers.meta || event.modifiers.control) && (event.text == "f" || event.text == "F") {
                    root.search-visible = true;
                    control-bar.focus-search();
                    return accept;
                }
                // ↑/↓ déplacent la sélection dans la liste des morceaux, Entrée la lance.
                if event.text == Key.UpArrow || event.text == Key.DownArrow {
                    root.move-selection(event.text == Key.UpArrow ? -1 : 1, event.modifiers.shift);
                    return accept;
                }
                if event.text == Key.Return {
                    root.activate();
                    return accept;
                }
                if event.text == Key.Tab || event.text == Key.Backtab {
                    root.cycle-panel(event.text == Key.Backtab || event.modifiers.shift ? -1 : 1);
                    return accept;
                }
                if event.text == Key.LeftArrow || event.text == Key.RightArrow {
                    // Les répétitions automatiques du clavier ne relancent rien.
                    if self.held == 0 {
                        self.held = event.text == Key.LeftArrow ? -1 : 1;
                        self.seeking = false;
                        hold.running = true;
                    }
                    return accept;
                }
                return reject;
            }
            key-released(event) => {
                if (event.text == Key.LeftArrow || event.text == Key.RightArrow) && self.held != 0 {
                    hold.running = false;
                    repeat.running = false;
                    if !self.seeking {
                        if self.held < 0 {
                            root.previous();
                        } else {
                            root.next();
                        }
                    }
                    self.held = 0;
                    return accept;
                }
                return reject;
            }
        }

        Rectangle {
            VerticalLayout {
                control-bar := ControlBar {
                    title: root.now-title;
                    artwork: root.now-artwork;
                    has-artwork: root.now-has-artwork;
                    has-track: root.playing-track != -1;
                    playing: root.playing;
                    position: root.position;
                    duration: root.duration;
                    position-text: root.position-text;
                    duration-text: root.duration-text;
                    remaining-text: root.remaining-text;
                    search-visible <=> root.search-visible;
                    search-text <=> root.search-text;
                    random-mode <=> root.random-mode;
                    loop-mode <=> root.loop-mode;
                    volume <=> root.volume;
                    muted <=> root.muted;
                    show-current => {
                        root.show-current();
                    }
                    previous => {
                        root.previous();
                    }
                    toggle-play => {
                        root.toggle-play();
                    }
                    next => {
                        root.next();
                    }
                    seek(ratio) => {
                        root.seek(ratio);
                    }
                    search(text) => {
                        root.search(text);
                    }
                    search-closed => {
                        keys.focus();
                    }
                }

                HorizontalLayout {
                    vertical-stretch: 1;

                    Sidebar {
                        libraries: root.libraries;
                        selected-library: root.selected-library;
                        playlists: root.playlists;
                        selected-playlist: root.selected-playlist;
                        view: root.view;
                        letter: root.letter;
                        most-played-count: root.most-played-count;
                        favorite-artists-count: root.favorite-artists-count;
                        favorite-albums-count: root.favorite-albums-count;
                        favorite-tracks-count: root.favorite-tracks-count;
                        show-equalizer: root.show-equalizer;
                        playlist-selected: root.view == View.playlist && root.selected-playlist != -1;
                        scanning: root.scanning;
                        recent-amount: root.recent-amount;
                        recent-unit: root.recent-unit;
                        library-menu(action) => {
                            root.library-menu(action);
                        }
                        playlist-menu(action) => {
                            root.playlist-menu(action);
                        }
                        recent-changed(amount, unit) => {
                            root.recent-changed(amount, unit);
                        }
                        select-letter(letter) => {
                            root.select-letter(letter);
                        }
                        select-library(id) => {
                            root.select-library(id);
                        }
                        select-view(view) => {
                            root.select-view(view);
                        }
                        select-playlist(id) => {
                            root.select-playlist(id);
                        }
                        accepts(data) => {
                            return root.is-track-payload(data);
                        }
                        drop-on-playlist(id, data) => {
                            root.drop-on-playlist(id, data);
                        }
                    }

                    if root.view != View.playlist: Rectangle {
                        width: root.artists-width;
                        background: Theme.panel-bg;

                        VerticalLayout {
                            PanelHeader {
                                title: @tr("Artists");
                                badge: @tr("{n} artist" | "{n} artists" % root.artists-count);
                                active: root.active-panel == 0;
                            }
                            ArtistList {
                                items: root.artists;
                                selected: root.selected-artist;
                                cursor: root.active-panel == 0 ? root.artist-cursor : -1;
                                reveal-row: root.artist-reveal-row;
                                reveal-serial: root.artist-reveal-serial;
                                clicked(id) => {
                                    root.select-artist(id);
                                }
                                action(id, name) => {
                                    root.artist-action(id, name);
                                }
                                payload(id) => {
                                    return root.artist-payload(id);
                                }
                            }
                        }
                    }

                    if root.view != View.playlist: Splitter {
                        target <=> root.artists-width;
                    }

                    if root.view != View.playlist: Rectangle {
                        width: root.albums-width;
                        background: Theme.panel-bg;

                        VerticalLayout {
                            PanelHeader {
                                title: @tr("Albums");
                                badge: @tr("{n} album" | "{n} albums" % root.albums-count);
                                active: root.active-panel == 1;
                            }
                            AlbumList {
                                items: root.albums;
                                selected: root.selected-album;
                                cursor: root.active-panel == 1 ? root.album-cursor : -1;
                                reveal-row: root.album-reveal-row;
                                reveal-serial: root.album-reveal-serial;
                                clicked(id) => {
                                    root.select-album(id);
                                }
                                action(id, name) => {
                                    root.album-action(id, name);
                                }
                                payload(id) => {
                                    return root.album-payload(id);
                                }
                            }
                        }
                    }

                    if root.view != View.playlist: Splitter {
                        target <=> root.albums-width;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.panel-bg;

                        if root.view != View.playlist: VerticalLayout {
                            PanelHeader {
                                title: @tr("Tracks");
                                active: root.active-panel == 2;
                                badge: @tr("{n} track" | "{n} tracks" % root.tracks-count);
                            }
                            TrackList {
                                reveal-row: root.reveal-row;
                                reveal-serial: root.reveal-serial;
                                items: root.track-items;
                                playing-track: root.playing-track;
                                running: root.playing;
                                selected-track <=> root.selected-track;
                                select-track(id, toggle, extend) => {
                                    root.track-clicked(id, toggle, extend);
                                }
                                play-track(id) => {
                                    root.play-track(id);
                                }
                                track-action(id, name) => {
                                    root.track-action(id, name);
                                }
                                track-payload(id) => {
                                    return root.track-payload(id);
                                }
                            }
                        }

                        if root.view == View.playlist: VerticalLayout {
                            PanelHeader {
                                title: root.playlist-name;
                                active: root.active-panel == 2;
                                badge: @tr("{n} track" | "{n} tracks" % root.tracks-count);
                            }
                            PlaylistTrackList {
                                reveal-row: root.reveal-row;
                                reveal-serial: root.reveal-serial;
                                items: root.playlist-items;
                                playing-track: root.playing-track;
                                running: root.playing;
                                selected-track <=> root.selected-track;
                                select-track(id, toggle, extend) => {
                                    root.track-clicked(id, toggle, extend);
                                }
                                play-track(id) => {
                                    root.play-track(id);
                                }
                                track-action(id, name) => {
                                    root.track-action(id, name);
                                }
                                track-payload(id) => {
                                    return root.track-payload(id);
                                }
                                accepts(data) => {
                                    return root.is-track-payload(data);
                                }
                                reorder(data, row) => {
                                    root.playlist-reorder(data, row);
                                }
                            }
                        }
                    }

                    if root.tags-open: Splitter {
                        target <=> root.tags-width;
                        minimum: 220px;
                        reversed: true;
                    }

                    if root.tags-open: TagsDrawer {
                        width: root.tags-width;
                        rows: root.tag-rows;
                        choices: root.tag-choices;
                        count: root.tag-count;
                        editing: root.tags-editing;
                        saving: root.tags-saving;
                        edit => {
                            root.tags-edit();
                        }
                        save => {
                            keys.focus();
                            root.tags-save();
                        }
                        cancel => {
                            keys.focus();
                            root.tags-cancel();
                        }
                        value-edited(key, value) => {
                            root.tag-edited(key, value);
                        }
                        toggle-field(key) => {
                            root.tag-field-toggled(key);
                        }
                    }
                }

                StatusBar {
                    source: root.view == View.playlist ? StatusSource.playlist
                        : root.view == View.recent ? StatusSource.recent
                        : root.library-name == "" ? StatusSource.none : StatusSource.library;
                    source-name: root.view == View.playlist ? root.playlist-name : root.library-name;
                    artists: root.library-artists;
                    albums: root.library-albums;
                    tracks: root.library-count;
                    message: root.status.kind == StatusKind.summary ? "" : root.status-text;
                    version: root.version;
                    show-equalizer <=> root.show-equalizer;
                    show-tags <=> root.tags-open;
                    tags-toggled => {
                        root.tags-toggled();
                    }
                    zoom-edited(value) => {
                        root.zoom-edited(value);
                    }
                    toggle-theme => {
                        root.toggle-theme();
                    }
                    database-path: root.database-path;
                    path-closed => {
                        keys.focus();
                    }
                    scanning: root.scanning;
                    stop-scan => {
                        root.stop-scan();
                    }
                }
            }
        }
    }

    name-dialog := NameDialog {
        visible: root.dialog-open;
        kind: root.dialog-kind;
        text <=> root.dialog-text;
        taken: root.dialog-taken;
        accepted(value) => {
            root.dialog-accepted(value);
        }
        cancelled => {
            root.close-dialog();
        }
    }

    confirm-dialog := ConfirmDialog {
        visible: root.confirm-open;
        kind: root.confirm-kind;
        subject: root.confirm-subject;
        count: root.confirm-count;
        confirmed => {
            root.close-confirm();
            root.confirm-accepted();
        }
        cancelled => {
            root.close-confirm();
        }
    }
}
