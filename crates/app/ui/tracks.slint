import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Artwork, PlayingIndicator, TrackMenu, ThemedMenu, Menus } from "widgets.slint";

export { TrackMenu }

export enum TrackItemKind { album-header, track }

// Une ligne de la liste des morceaux : en-tête d'album ou morceau.
export struct TrackItem {
    kind: TrackItemKind,
    id: int,
    number: int,
    title: string,
    duration: string,
    disc: string,
    artist: string,
    album: string,
    year: int,
    track-count: int,
    artwork: image,
    has-artwork: bool,
    first-in-album: bool,
    favorite: bool,
    // Fait partie de la sélection (multiple avec Cmd/Ctrl ou Maj).
    selected: bool,
}


// Mesures de la v0.1 : lignes de 43px, colonne de jaquette de 92px (80px + marge).
global Metrics {
    out property <length> row: 43px;
    out property <length> cell: 32px;
    out property <length> padding: 12px;
    out property <length> artwork-column: 92px;
    out property <length> artwork: 80px;
    out property <length> number: 50px;
    out property <length> duration: 70px;
    out property <length> disc: 50px;
}

// Les actions sont des chaînes transmises à Rust ; « add-to-playlist:<id> » vise une playlist.
// La jaquette de 80px commence dans l'en-tête et déborde sur le premier morceau.
// Chaque ligne dessine sa tranche (`offset`) : le rendu reste juste même quand la
// ListView a recyclé l'en-tête hors de l'écran.
component ArtworkSlice inherits Rectangle {
    in property <TrackItem> item;
    in property <length> offset;
    x: Metrics.padding;
    width: Metrics.artwork-column;
    clip: true;

    Artwork {
        x: 0;
        y: 1px - root.offset;
        size: Metrics.artwork;
        radius: 6px;
        icon-size: 32px;
        source: root.item.artwork;
        has-image: root.item.has-artwork;
    }
}

component AlbumHeaderRow inherits Rectangle {
    in property <TrackItem> item;
    height: Metrics.row;

    ArtworkSlice {
        item: root.item;
        offset: 0;
    }

    Rectangle {
        x: Metrics.padding + Metrics.artwork-column;
        width: parent.width - self.x - Metrics.padding;
        height: Metrics.cell;
        border-radius: 4px;
        background: Theme.group-bg;

        VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            alignment: center;
            spacing: 1px;
            Text {
                text: root.item.album;
                font-size: 12px;
                font-weight: 600;
                color: Theme.text-primary;
                horizontal-alignment: center;
                overflow: elide;
            }
            Text {
                // Année inconnue (0) : omise.
                text: root.item.artist + (root.item.year > 0 ? " • " + root.item.year : "") + " • " + @tr("{n} track" | "{n} tracks" % root.item.track-count);
                font-size: 10px;
                color: Theme.text-tertiary;
                horizontal-alignment: center;
                overflow: elide;
            }
        }
    }
}

component TrackListRow inherits Rectangle {
    in property <TrackItem> item;
    in property <bool> selected;
    in property <bool> playing;
    in property <bool> running;
    // `toggle` : Cmd/Ctrl-clic ; `extend` : Maj-clic.
    callback select(bool, bool);
    property <bool> modified-press;
    callback play();
    callback action(string);
    pure callback payload(int, int) -> data-transfer;
    height: Metrics.row;

    Rectangle {
        y: parent.height - Theme.hairline;
        height: Theme.hairline;
        background: Theme.item-border;
    }

    if root.item.first-in-album: ArtworkSlice {
        item: root.item;
        offset: Metrics.row;
    }

    DragArea {
        x: Metrics.padding + Metrics.artwork-column;
        width: parent.width - self.x - Metrics.padding;
        allow-copy: true;
        data: root.payload(root.item.id, TrackMenu.selection-serial);

        Rectangle {
            height: Metrics.cell;
            background: root.playing ? Theme.playing-bg : (root.selected ? Theme.current-bg : (touch.has-hover ? Theme.item-hover : transparent));

            Rectangle {
                x: 0;
                width: 3px;
                background: root.playing ? Theme.accent : transparent;
            }

            touch := TouchArea {
                // Comme le Finder : un clic simple sur une piste déjà sélectionnée ne réduit la
                // sélection qu'au relâchement, pour pouvoir faire glisser tout le groupe.
                clicked => {
                    if !root.modified-press {
                        root.select(false, false);
                    }
                }
                double-clicked => {
                    root.play();
                }
                // Clic droit : menu au style de l'app, à l'endroit du clic.
                pointer-event(event) => {
                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                        let toggle = event.modifiers.meta || event.modifiers.control;
                        root.modified-press = toggle || event.modifiers.shift;
                        if root.modified-press || !root.selected {
                            root.select(toggle, event.modifiers.shift && !toggle);
                        }
                    }
                    if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                        // Clic droit hors de la sélection : elle se réduit à cette piste.
                        if !root.selected {
                            root.select(false, false);
                        }
                        menu-anchor.x = self.mouse-x;
                        menu-anchor.y = self.mouse-y;
                        menu.show();
                    }
                }
            }
            menu-anchor := Rectangle {
                width: 0px;
                height: 0px;
                menu := ThemedMenu {
                    entries: Menus.track(root.item.favorite);
                    selected(name) => {
                        root.action(name);
                    }
                }
            }

            HorizontalLayout {
                Rectangle {
                    width: Metrics.number;
                    if root.playing && root.running: PlayingIndicator {
                        alignment: center;
                    }
                    if !(root.playing && root.running): Text {
                        // 0 = numéro absent des tags.
                        text: root.item.number > 0 ? root.item.number : "";
                        font-size: 12px;
                        color: root.playing ? Theme.accent : Theme.text-tertiary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 8px;
                    horizontal-stretch: 1;
                    Text {
                        text: root.item.title;
                        font-size: 13px;
                        font-weight: root.playing || root.selected ? 500 : 400;
                        color: root.playing || root.selected ? Theme.accent : Theme.text-primary;
                        vertical-alignment: center;
                        overflow: elide;
                        min-width: 0px;
                    }
                }
                HorizontalLayout {
                    width: Metrics.duration;
                    padding-right: 16px;
                    Text {
                        text: root.item.duration;
                        font-size: 11px;
                        color: Theme.text-tertiary;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    width: Metrics.disc;
                    padding-right: 16px;
                    Text {
                        text: root.item.disc;
                        font-size: 11px;
                        color: Theme.text-tertiary;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

component ColumnLabel inherits Text {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.4px;
    color: Theme.text-tertiary;
    vertical-alignment: center;
}

// Vue bibliothèque : morceaux groupés par album, avec jaquettes.
export component TrackList inherits VerticalLayout {
    in property <[TrackItem]> items;
    in property <int> playing-track: -1;
    in property <bool> running;
    // Ligne à rendre visible (en-têtes d'album compris) ; `reveal-serial` change à chaque demande.
    in property <int> reveal-row;
    in property <int> reveal-serial;
    changed reveal-serial => {
        let top = root.reveal-row * Metrics.row;
        if top < -list.content-y {
            list.content-y = -top;
        } else if top + Metrics.row > -list.content-y + list.visible-height {
            list.content-y = -(top + Metrics.row - list.visible-height);
        }
    }
    // Piste courante (clavier, Entrée) ; la sélection est portée par `TrackItem.selected`.
    in-out property <int> selected-track: -1;
    callback select-track(int, bool, bool);
    callback play-track(int);
    callback track-action(int, string);
    pure callback track-payload(int) -> data-transfer;

    Rectangle {
        height: 25px;

        HorizontalLayout {
            padding-left: Metrics.padding + Metrics.artwork-column;
            padding-right: Metrics.padding;
            ColumnLabel {
                width: Metrics.number;
                text: "#";
                horizontal-alignment: center;
            }
            HorizontalLayout {
                padding-left: 16px;
                horizontal-stretch: 1;
                ColumnLabel {
                    text: @tr("Title").to-uppercase();
                }
            }
            HorizontalLayout {
                width: Metrics.duration;
                padding-right: 16px;
                ColumnLabel {
                    text: @tr("Time").to-uppercase();
                    horizontal-alignment: right;
                }
            }
            HorizontalLayout {
                width: Metrics.disc;
                padding-right: 16px;
                ColumnLabel {
                    text: @tr("Disc").to-uppercase();
                    horizontal-alignment: right;
                }
            }
        }

        Rectangle {
            y: parent.height - Theme.hairline;
            height: Theme.hairline;
            background: Theme.item-border;
        }
    }

    // ListView n'instancie que les lignes visibles : 10 000+ morceaux restent fluides.
    list := ListView {
        for item in root.items: Rectangle {
            height: Metrics.row;

            if item.kind == TrackItemKind.album-header: AlbumHeaderRow {
                item: item;
            }
            if item.kind == TrackItemKind.track: TrackListRow {
                item: item;
                selected: item.selected;
                playing: item.id == root.playing-track;
                running: root.running;
                select(toggle, extend) => {
                    root.select-track(item.id, toggle, extend);
                }
                play => {
                    root.play-track(item.id);
                }
                action(name) => {
                    root.track-action(item.id, name);
                }
                payload(id, serial) => {
                    return root.track-payload(id);
                }
            }
        }
    }
}

// Ligne de playlist (52px) : position, petite jaquette, titre et artiste • album.
component PlaylistTrackRow inherits Rectangle {
    in property <TrackItem> item;
    in property <bool> selected;
    in property <bool> playing;
    in property <bool> running;
    // `toggle` : Cmd/Ctrl-clic ; `extend` : Maj-clic.
    callback select(bool, bool);
    property <bool> modified-press;
    callback play();
    callback action(string);
    pure callback payload(int, int) -> data-transfer;
    // Dépôt sur la ligne : les éléments glissés sont placés à sa position.
    pure callback accepts(data-transfer) -> bool;
    callback dropped(data-transfer);
    height: 52px;
    background: root.playing ? Theme.playing-bg : (root.selected ? Theme.current-bg : (touch.has-hover ? Theme.item-hover : transparent));

    Rectangle {
        y: parent.height - Theme.hairline;
        height: Theme.hairline;
        background: Theme.item-border;
    }
    Rectangle {
        x: 0;
        width: 3px;
        background: root.playing ? Theme.accent : transparent;
    }

    drop := DropArea {
        can-drop(event) => {
            return root.accepts(event.data) ? DragAction.copy : DragAction.none;
        }
        dropped(event) => {
            root.dropped(event.data);
            return event.proposed-action;
        }

    DragArea {
        allow-copy: true;
        data: root.payload(root.item.id, TrackMenu.selection-serial);

        touch := TouchArea {
            // Comme le Finder : un clic simple sur une piste déjà sélectionnée ne réduit la
            // sélection qu'au relâchement, pour pouvoir faire glisser tout le groupe.
            clicked => {
                if !root.modified-press {
                    root.select(false, false);
                }
            }
            double-clicked => {
                root.play();
            }
            // Clic droit : menu au style de l'app, à l'endroit du clic.
            pointer-event(event) => {
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    let toggle = event.modifiers.meta || event.modifiers.control;
                    root.modified-press = toggle || event.modifiers.shift;
                    if root.modified-press || !root.selected {
                        root.select(toggle, event.modifiers.shift && !toggle);
                    }
                }
                if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                    // Clic droit hors de la sélection : elle se réduit à cette piste.
                    if !root.selected {
                        root.select(false, false);
                    }
                    menu-anchor.x = self.mouse-x;
                    menu-anchor.y = self.mouse-y;
                    menu.show();
                }
            }
        }
        menu-anchor := Rectangle {
            width: 0px;
            height: 0px;
            menu := ThemedMenu {
                entries: Menus.track(root.item.favorite);
                selected(name) => {
                    root.action(name);
                }
            }
        }

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            Rectangle {
                width: 36px;
                if root.playing && root.running: PlayingIndicator {
                    alignment: center;
                }
                if !(root.playing && root.running): Text {
                    text: root.item.number;
                    font-size: 12px;
                    color: root.playing ? Theme.accent : Theme.text-tertiary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                width: 48px;
                Artwork {
                    size: 36px;
                    radius: 3px;
                    icon-size: 14px;
                    source: root.item.artwork;
                    has-image: root.item.has-artwork;
                }
            }
            VerticalLayout {
                padding-left: 4px;
                padding-right: 8px;
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: root.item.title;
                    font-size: 13px;
                    font-weight: root.playing || root.selected ? 500 : 400;
                    color: root.playing || root.selected ? Theme.accent : Theme.text-primary;
                    overflow: elide;
                }
                Text {
                    text: root.item.artist + " • " + root.item.album;
                    font-size: 11px;
                    color: Theme.text-tertiary;
                    overflow: elide;
                }
            }
            Text {
                width: Metrics.duration;
                text: root.item.duration;
                font-size: 11px;
                color: Theme.text-tertiary;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
    }
    }

    // Trait d'insertion pendant un glisser au-dessus de la ligne.
    if drop.has-drag: Rectangle {
        y: 0;
        height: 2px;
        background: Theme.accent;
    }
}

export component PlaylistTrackList inherits ListView {
    in property <[TrackItem]> items;
    in property <int> reveal-row;
    in property <int> reveal-serial;
    changed reveal-serial => {
        let top = root.reveal-row * 52px;
        if top < -root.content-y {
            root.content-y = -top;
        } else if top + 52px > -root.content-y + root.visible-height {
            root.content-y = -(top + 52px - root.visible-height);
        }
    }
    in property <int> playing-track: -1;
    in property <bool> running;
    // Piste courante (clavier, Entrée) ; la sélection est portée par `TrackItem.selected`.
    in-out property <int> selected-track: -1;
    callback select-track(int, bool, bool);
    callback play-track(int);
    callback track-action(int, string);
    pure callback track-payload(int) -> data-transfer;
    pure callback accepts(data-transfer) -> bool;
    // Éléments glissés sur la ligne `row` : à placer à cette position.
    callback reorder(data-transfer, int);

    for item[row] in root.items: PlaylistTrackRow {
        item: item;
        selected: item.selected;
        playing: item.id == root.playing-track;
        running: root.running;
        select(toggle, extend) => {
            root.select-track(item.id, toggle, extend);
        }
        play => {
            root.play-track(item.id);
        }
        action(name) => {
            root.track-action(item.id, name);
        }
        payload(id, serial) => {
            return root.track-payload(id);
        }
        accepts(data) => {
            return root.accepts(data);
        }
        dropped(data) => {
            root.reorder(data, row);
        }
    }
}
